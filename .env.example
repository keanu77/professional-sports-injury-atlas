# Optional YouTube Data API key for external-source identity/embeddability
# checks. Without it the verifier records youtubeApiKeyState=not-obtained and
# skips only the API identity comparison; never print or commit a real key.
YOUTUBE_API_KEY=

# Local/CI verification only. Defaults preserve review mode and production behavior.
# ATLAS_PUBLIC_PREVIEW=1 selects isolated artifacts/public-preview, noindex and no playback counters.
# ATLAS_E2E_MODE=public-preview enables tests against that public-shaped preview.
# ATLAS_LIGHTHOUSE_MODE=public-preview measures the same isolated artifact.
# ATLAS_HEALTH_ORIGIN=https://injury.sportsmedicine.tw selects an allowlisted monitoring target.
