---
/**
 * Case detail route, generated only from actual selector-permitted entries.
 * Desktop places the video left and the dual-layer notes right; the DOM
 * order stays video → general notes → professional notes → related
 * cases so the mobile reading order is correct without JavaScript.
 * Review builds additionally expose the record ID, content digest, and the
 * rendered-set digest as copyable text, plus the private workflow badge that
 * never masquerades as a diagnosis.
 */
import { getCollection, type CollectionEntry } from "astro:content";
import CaseCard from "../../components/atlas/CaseCard.astro";
import EditorialHero from "../../components/atlas/EditorialHero.astro";
import CaseVideo from "../../components/cases/CaseVideo.astro";
import FollowUpReports from "../../components/cases/FollowUpReports.astro";
import ReviewDigestDisclosure from "../../components/cases/ReviewDigestDisclosure.astro";
import ExternalSourceCitation from "../../components/citations/ExternalSourceCitation.astro";
import LayeredNotes from "../../components/cases/LayeredNotes.astro";
import MedicalNotice from "../../components/notices/MedicalNotice.astro";
import ReviewBadge from "../../components/cases/ReviewBadge.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { computeCaseContentDigest } from "../../lib/cases/digest";
import {
  permittedCasesForMode,
  relatedCases,
} from "../../lib/cases/pagination";
import { findInjury, findLeague } from "../../lib/contracts/taxonomy";
import { resolveBuildMode } from "../../lib/governance/build-mode";
import {
  caseRouteParams,
  CLASSIC_CASE_LABEL,
  computeRenderedSetDigest,
  confirmationStatusLabel,
} from "../../lib/routes/static-paths";
import { caseImageFor } from "../../lib/ui/editorial-images";
import { loadFollowUpCorpus } from "../../lib/cases/follow-up-loader";
import { FOLLOW_UP_SOURCE_POLICY_V10_BINDING } from "../../lib/contracts/case-follow-up";

export function validatedFollowUps(
  caseRecords: readonly CollectionEntry<"cases">[],
) {
  const corpus = loadFollowUpCorpus(
    process.cwd(),
    caseRecords.map((entry) => entry.data),
    { expectedPolicyBinding: FOLLOW_UP_SOURCE_POLICY_V10_BINDING },
  );
  if (corpus.issues.length > 0) {
    throw new Error(
      `invalid Decision 17 follow-up corpus: ${corpus.issues
        .map((entry) => `${entry.code}:${entry.path}`)
        .join(", ")}`,
    );
  }
  return corpus.entries;
}

export async function getStaticPaths(): Promise<
  Array<{ params: { slug: string } }>
> {
  const mode = resolveBuildMode(process.env.ATLAS_BUILD_MODE);
  const caseEntries = await getCollection("cases");
  const caseRecords = caseEntries.map((entry) => entry.data);
  if (mode === "review") validatedFollowUps(caseEntries);
  return caseRouteParams(mode, caseRecords).map((params) => ({ params }));
}

const { slug } = Astro.params;
const buildMode = resolveBuildMode(process.env.ATLAS_BUILD_MODE);
const caseRecords = (await getCollection("cases")).map((entry) => entry.data);
const permitted = permittedCasesForMode(buildMode, caseRecords);
const record = permitted.find((candidate) => candidate.slug === slug);
if (record === undefined) {
  throw new Error(`case route for unknown permitted slug ${String(slug)}`);
}

const injuryLabel =
  findInjury(record.injury.code)?.labelZh ?? record.injury.code;
const leagueLabel =
  findLeague(record.league.code)?.labelZh ?? record.league.code;
const related = relatedCases(record, permitted);
const contentDigest = computeCaseContentDigest(record);
const renderedSetDigest = computeRenderedSetDigest(permitted);
const followUpEntry =
  buildMode === "review"
    ? validatedFollowUps(await getCollection("cases")).find(
        (entry) => entry.sidecar.caseId === record.id,
      )
    : undefined;
if (buildMode === "review" && followUpEntry === undefined) {
  throw new Error(`missing Decision 17 follow-up sidecar for ${record.id}`);
}
const heroSelection = caseImageFor(
  record.injury.code,
  record.id,
  record.athlete.name,
);
const videoSource = record.sources.find(
  (source) =>
    source.type === "video-original" &&
    source.url === record.video.canonicalUrl,
);
if (videoSource === undefined) {
  throw new Error(`missing canonical video source citation for ${record.id}`);
}
---

<BaseLayout
  title={`${record.athlete.name}｜${injuryLabel}｜職業運動傷害影片圖鑑`}
  description={`${record.athlete.name} 的 ${injuryLabel} 教學案例：可見過程觀察與外部確認診斷。`}
  artifactRecordIds={[record.id]}
  artifactDigest={contentDigest}
  heroImage={heroSelection.image}
  heroImageMode="case"
  heroImageSizes="(min-width: 48rem) 48rem, calc(100vw - 2rem)"
>
  <article
    data-atlas-view="case-detail"
    data-case-id={record.id}
    data-injury-theme={record.injury.code}
  >
    <MedicalNotice variant="compact" />
    <EditorialHero
      variant="case"
      injuryCode={record.injury.code}
      injuryLabel={injuryLabel}
      recordId={record.id}
      athleteName={record.athlete.name}
      imageAlt={`${injuryLabel}匿名運動員運動醫學攝影意象；面孔不可見，不代表${record.athlete.name}或任何特定球員，也不是實際受傷畫面。`}
    >
      <span slot="eyebrow">
        <span class="injury-name">{injuryLabel}</span><span>·</span><span
          >{leagueLabel}</span
        >
      </span>
      <h1 slot="title">{record.athlete.name}｜{injuryLabel}</h1>
      <p slot="meta" class="case-facts">
        {leagueLabel}｜{record.season} 球季｜{record.eventDate}｜
        {record.teamAtEvent.name} 對 {record.opponent.name}
      </p>
    </EditorialHero>

    <p
      class="case-confirmation meta-row"
      data-confirmation-status={record.injury.confirmationStatus}
    >
      診斷確認狀態（外部來源）：
      <strong
        >{confirmationStatusLabel(record.injury.confirmationStatus)}</strong
      >
      ｜外部確認診斷：{record.injury.confirmedDiagnosis}
    </p>
    {
      record.isClassic && (
        <p class="case-classic meta-row" data-classic-label>
          <strong>{CLASSIC_CASE_LABEL}</strong>
          {record.classicReason !== null && <>：{record.classicReason}</>}
        </p>
      )
    }
    {buildMode === "review" && <ReviewBadge record={record} />}
    <p class="mechanism-tags meta-row">
      可見機轉標籤（觀察分類，非診斷）：{
        record.observedMechanismTags.join("、")
      }
    </p>

    <section aria-labelledby="case-analysis-heading">
      <h2 class="section-title" id="case-analysis-heading">
        案例影片與雙層筆記
      </h2>
      <div class="case-detail-grid">
        <div class="case-video-column">
          <CaseVideo
            athleteName={record.athlete.name}
            scopeId={record.slug}
            recordId={record.id}
            displayMode={buildMode}
            sourceTitle={`${record.athlete.name} 案例影片（原始平台來源）`}
            sourceCitation={videoSource}
            injuryCode={record.injury.code}
            injuryLabel={injuryLabel}
            video={{
              provider: record.video.provider,
              canonicalUrl: record.video.canonicalUrl,
              uploaderName: record.video.uploaderName,
              durationSeconds: record.video.durationSeconds,
              embedStatus: record.video.embedStatus,
              captionStatus: record.video.captionStatus,
            }}
          />
        </div>
        <div class="case-notes-column">
          <LayeredNotes
            scopeId={record.slug}
            whatVideoCannotProve={record.general.whatVideoCannotProve}
            professional={record.professional}
          />
        </div>
      </div>
    </section>

    {
      followUpEntry !== undefined && (
        <FollowUpReports
          buildMode={buildMode}
          record={record}
          followUp={followUpEntry.sidecar}
        />
      )
    }

    <section class="case-section" aria-labelledby="sources-heading">
      <h2 class="section-title" id="sources-heading">來源與證據</h2>
      <ul class="source-list">
        {
          record.sources.map((source) => (
            <li>
              <ExternalSourceCitation
                context="source-list"
                sourceId={source.id}
                {...source}
              />
            </li>
          ))
        }
      </ul>
    </section>

    {
      buildMode === "review" && (
        <ReviewDigestDisclosure
          scopeId={record.slug}
          recordId={record.id}
          contentDigest={contentDigest}
          renderedSetDigest={renderedSetDigest}
          followUpDigest={followUpEntry?.draftDigest}
        />
      )
    }

    <section class="case-section" aria-labelledby="related-heading">
      <h2 class="section-title" id="related-heading">
        其他 {injuryLabel} 案例（最多 3 筆）
      </h2>
      {
        related.length === 0 ? (
          <p>目前沒有其他已審查的 {injuryLabel} 案例。</p>
        ) : (
          <ol class="case-list">
            {related.map((candidate) => (
              <li>
                <CaseCard
                  record={candidate}
                  showWorkflowBadge={buildMode === "review"}
                />
              </li>
            ))}
          </ol>
        )
      }
    </section>
  </article>
</BaseLayout>

<style>
  .case-detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    margin: var(--space-block) 0 0;
  }

  @media (min-width: 64rem) {
    .case-detail-grid {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    }
  }

  .case-notes-column {
    max-width: 42rem;
  }

  .case-confirmation {
    display: inline-block;
    margin: 0.75rem 0 0;
    border: 1px solid var(--hairline);
    border-radius: 2px;
    padding: 2px 10px;
  }

  .case-confirmation[data-confirmation-status="confirmed"] {
    border-inline-start: 3px solid var(--color-brand-primary);
  }

  .case-classic {
    border-inline-start: 3px solid var(--color-metric);
    padding-inline-start: 0.75rem;
  }

  .mechanism-tags {
    margin-block-start: 1rem;
  }

  .case-section {
    margin-block-start: var(--space-section);
  }

  .case-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(19rem, 100%), 1fr));
    gap: 2.5rem 1.5rem;
    margin: var(--space-block) 0 0;
    padding: 0;
    list-style: none;
  }

  .source-list li {
    margin-bottom: 0.5rem;
  }
</style>
