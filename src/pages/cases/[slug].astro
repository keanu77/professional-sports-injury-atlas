---
/**
 * Case detail route, generated only from actual selector-permitted entries.
 * Desktop places the video left and the professional notes right; the DOM
 * order stays video → professional notes → related cases so the mobile
 * reading order is correct without JavaScript.
 * Review builds additionally expose the record ID, content digest, and the
 * rendered-set digest as copyable text, plus the private workflow badge that
 * never masquerades as a diagnosis.
 */
import { MECHANISMS } from "../../data/taxonomy/mechanisms";
import { getCollection, type CollectionEntry } from "astro:content";
import DetailNavigation from "../../components/atlas/DetailNavigation.astro";
import DetailContents from "../../components/atlas/DetailContents.astro";
import DetailCategories from "../../components/atlas/DetailCategories.astro";
import RelatedVideos from "../../components/atlas/RelatedVideos.astro";
import VideoTypeTags from "../../components/atlas/VideoTypeTags.astro";
import { hasPublicEmbed } from "../../lib/patient/featured";
import { isLaunchEnabled } from "../../lib/patient/public-launch";
import { observationClips } from "../../lib/videos/expansion";
import {
  caseCategoryLinks,
  relatedVideosFor,
} from "../../lib/videos/related-videos";
import PatientGuide from "../../components/cases/PatientGuide.astro";
import EventFollowUp from "../../components/cases/EventFollowUp.astro";
import EventMechanism from "../../components/cases/EventMechanism.astro";
import { eventUpdateFor } from "../../lib/videos/event-updates";
import ActualReturn from "../../components/cases/ActualReturn.astro";
import CaseVideo from "../../components/cases/CaseVideo.astro";
import FollowUpReports from "../../components/cases/FollowUpReports.astro";
import ReviewDigestDisclosure from "../../components/cases/ReviewDigestDisclosure.astro";
import ExternalSourceCitation from "../../components/citations/ExternalSourceCitation.astro";
import ProfessionalNotes from "../../components/cases/ProfessionalNotes.astro";
import MedicalNotice from "../../components/notices/MedicalNotice.astro";
import ReviewBadge from "../../components/cases/ReviewBadge.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { computeCaseContentDigest } from "../../lib/cases/digest";
import { permittedCasesForMode } from "../../lib/cases/pagination";
import { findInjury, findLeague } from "../../lib/contracts/taxonomy";
import { resolveBuildMode } from "../../lib/governance/build-mode";
import {
  caseRouteParams,
  CLASSIC_CASE_LABEL,
  computeRenderedSetDigest,
  confirmationStatusLabel,
} from "../../lib/routes/static-paths";
import { loadReviewFollowUpCorpus } from "../../lib/cases/follow-up-approval-ledger";
import { FOLLOW_UP_SOURCE_POLICY_V10_BINDING } from "../../lib/contracts/case-follow-up";
import {
  contentTypeSegmentsFor,
  contentTypesFor,
} from "../../lib/videos/content-types";
import { parseYouTubeVideoId } from "../../lib/video/youtube";
import { formatDurationLabel } from "../../lib/video/player-state";

export function validatedFollowUps(
  caseRecords: readonly CollectionEntry<"cases">[],
) {
  const corpus = loadReviewFollowUpCorpus(
    process.cwd(),
    caseRecords.map((entry) => entry.data),
    { expectedPolicyBinding: FOLLOW_UP_SOURCE_POLICY_V10_BINDING },
  );
  if (corpus.issues.length > 0) {
    throw new Error(
      `invalid Decision 18 transitional follow-up corpus: ${corpus.issues
        .map((entry) => `${entry.code}:${entry.path}`)
        .join(", ")}`,
    );
  }
  return corpus.entries;
}

export async function getStaticPaths(): Promise<
  Array<{ params: { slug: string } }>
> {
  const mode = resolveBuildMode(process.env.ATLAS_BUILD_MODE);
  const caseEntries = await getCollection("cases");
  const caseRecords = caseEntries.map((entry) => entry.data);
  validatedFollowUps(caseEntries);
  return caseRouteParams(mode, caseRecords).map((params) => ({ params }));
}

const { slug } = Astro.params;
const buildMode = resolveBuildMode(process.env.ATLAS_BUILD_MODE);
const caseRecords = (await getCollection("cases")).map((entry) => entry.data);
const permitted = permittedCasesForMode(buildMode, caseRecords);
const record = permitted.find((candidate) => candidate.slug === slug);
if (record === undefined) {
  throw new Error(`case route for unknown permitted slug ${String(slug)}`);
}

const reportedUpdate = eventUpdateFor(
  record.slug,
  record.video.canonicalUrl,
  record.eventDate,
);
// Include enriched reports in local review without changing the frozen case record.
const eventUpdate =
  buildMode === "public" || reportedUpdate?.mechanism
    ? reportedUpdate
    : undefined;
const injuryLabel =
  findInjury(record.injury.code)?.labelZh ?? record.injury.code;
const leagueLabel =
  findLeague(record.league.code)?.labelZh ?? record.league.code;
const contentTypes = contentTypesFor(record.slug, record.video.canonicalUrl);
const contentSegments = contentTypeSegmentsFor(
  record.slug,
  record.video.canonicalUrl,
);
const isYouTubeVideo = parseYouTubeVideoId(record.video.canonicalUrl) !== null;
const related = relatedVideosFor({ kind: "case", record }, [
  ...permitted
    .filter(hasPublicEmbed)
    .map((candidate) => ({ kind: "case" as const, record: candidate })),
  ...observationClips().map((clip) => ({ kind: "observation" as const, clip })),
]);
const categoryLinks = isLaunchEnabled() ? caseCategoryLinks(record) : [];
const contents = [
  { id: "case-analysis-heading", label: "受傷影片" },
  ...(eventUpdate?.mechanism
    ? [
        { id: `event-mechanism-${record.slug}`, label: "受傷機轉重點" },
        { id: "case-follow-up", label: "傷勢與後續" },
      ]
    : buildMode === "public"
      ? [{ id: "case-observation", label: "影片觀察" }]
      : []),
  { id: `${record.injury.code}-now`, label: "當下處理" },
  { id: `${record.injury.code}-urgent`, label: "就醫警訊" },
  ...(eventUpdate?.mechanism
    ? []
    : [{ id: "case-follow-up", label: "傷勢與後續" }]),
  { id: "case-sources", label: "完整來源" },
  { id: "related-heading", label: "繼續看" },
];
const contentDigest = computeCaseContentDigest(record);
const renderedSetDigest = computeRenderedSetDigest(permitted);
const followUpEntry = validatedFollowUps(await getCollection("cases")).find(
  (entry) => entry.sidecar.caseId === record.id,
);
if (buildMode === "review" && followUpEntry === undefined) {
  throw new Error(`missing transitional follow-up sidecar for ${record.id}`);
}
const videoSource = record.sources.find(
  (source) =>
    source.type === "video-original" &&
    source.url === record.video.canonicalUrl,
);
if (videoSource === undefined) {
  throw new Error(`missing canonical video source citation for ${record.id}`);
}
---

<BaseLayout
  title={`${record.athlete.name}｜${injuryLabel}｜運動傷害影片圖鑑`}
  description={`${record.athlete.name} 的 ${injuryLabel} 教學案例：可見過程觀察與外部確認診斷。`}
  artifactRecordIds={[record.id]}
  artifactDigest={contentDigest}
>
  <DetailNavigation
    title={record.athlete.name}
    category={categoryLinks.find((link) => link.kind === "body-part")}
  />
  <article
    data-atlas-view="case-detail"
    data-case-id={record.id}
    data-injury-theme={record.injury.code}
  >
    <MedicalNotice variant="compact" />
    <header class="case-heading">
      <p class="eyebrow">{injuryLabel} · {leagueLabel}</p>
      <h1>{record.athlete.name}｜{injuryLabel}</h1>
      <p class="case-facts">
        {record.eventDate}｜{record.teamAtEvent.name} 對 {record.opponent.name}
      </p>
      <VideoTypeTags slug={record.slug} videoUrl={record.video.canonicalUrl} />
    </header>
    <DetailContents sections={contents} />
    <section aria-labelledby="case-analysis-heading">
      <h2 class="section-title" id="case-analysis-heading">受傷當下的影片</h2>
      <div class="case-detail-grid">
        <div class="case-video-column">
          <CaseVideo
            compact
            athleteName={record.athlete.name}
            scopeId={record.slug}
            recordId={record.id}
            displayMode={buildMode}
            sourceTitle={`${record.athlete.name} 案例影片（原始平台來源）`}
            sourceCitation={videoSource}
            injuryCode={record.injury.code}
            injuryLabel={injuryLabel}
            video={{
              provider: record.video.provider,
              canonicalUrl: record.video.canonicalUrl,
              uploaderName: record.video.uploaderName,
              durationSeconds: record.video.durationSeconds,
              embedStatus: record.video.embedStatus,
              captionStatus: record.video.captionStatus,
            }}
          />
        </div>
      </div>
      {
        contentSegments.length > 0 && isYouTubeVideo && (
          <section class="case-video-segments" data-video-type-segments>
            <h3>已標記片段</h3>
            <ul>
              {contentSegments.map((segment) => {
                const segmentUrl = new URL(record.video.canonicalUrl);
                segmentUrl.searchParams.set("t", String(segment.startSeconds));
                const labels = segment.typeIds
                  .map(
                    (typeId) =>
                      contentTypes.find((type) => type.id === typeId)?.label,
                  )
                  .filter((label) => label !== undefined);
                return (
                  <li>
                    <a
                      href={segmentUrl.href}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {formatDurationLabel(segment.startSeconds)}：
                      {labels.join("、")}
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        )
      }
    </section>

    {
      buildMode === "public" && !eventUpdate?.mechanism && (
        <section
          class="case-section"
          id="case-observation"
          data-visible-observation
        >
          <>
            <h2>受傷當下看什麼</h2>
            <p>{record.general.whatIsVisible}</p>
          </>
        </section>
      )
    }
    {
      eventUpdate?.mechanism && (
        <>
          <EventMechanism update={eventUpdate} />
          <div id="case-follow-up">
            <EventFollowUp update={eventUpdate} />
          </div>
        </>
      )
    }
    <PatientGuide injuryCode={record.injury.code} buildMode={buildMode} />
    {
      eventUpdate?.mechanism ? null : eventUpdate ? (
        <div id="case-follow-up">
          <EventFollowUp update={eventUpdate} />
        </div>
      ) : (
        <div id="case-follow-up">
          <ActualReturn record={record} followUp={followUpEntry?.sidecar} />
        </div>
      )
    }
    <details class="case-disclosure">
      <summary
        >{eventUpdate ? "原始事件紀錄與詳細說明" : "深入了解這次受傷"}</summary
      >
      {
        eventUpdate && (
          <p>以下保留初始來源的原文紀錄；傷勢與出賽的後續更新請見上方。</p>
        )
      }
      <p
        class="case-confirmation meta-row"
        data-confirmation-status={record.injury.confirmationStatus}
      >
        診斷確認狀態（外部來源）：
        <strong
          >{confirmationStatusLabel(record.injury.confirmationStatus)}</strong
        >
        ｜外部確認診斷：{record.injury.confirmedDiagnosis}
      </p>
      {
        record.isClassic && (
          <p class="case-classic meta-row" data-classic-label>
            <strong>{CLASSIC_CASE_LABEL}</strong>
            {record.classicReason !== null && <>：{record.classicReason}</>}
          </p>
        )
      }
      {buildMode === "review" && <ReviewBadge record={record} />}
      <p class="mechanism-tags meta-row">
        可見機轉標籤（觀察分類，非診斷）：{
          record.observedMechanismTags
            .map((code) =>
              buildMode === "public"
                ? (MECHANISMS.find((item) => item.code === code)?.labelZh ??
                  "機轉不明")
                : code,
            )
            .join("、")
        }
      </p>

      <ProfessionalNotes professional={record.professional} />
    </details>
    <details class="case-disclosure" id="case-sources">
      <summary>後續報導與完整來源</summary>

      {
        followUpEntry !== undefined && (
          <FollowUpReports
            buildMode={buildMode}
            record={record}
            followUp={followUpEntry.sidecar}
          />
        )
      }

      <section class="case-section" aria-labelledby="sources-heading">
        <h2 class="section-title" id="sources-heading">來源與證據</h2>
        <ul class="source-list">
          {
            record.sources.map((source) => (
              <li>
                <ExternalSourceCitation
                  context="source-list"
                  sourceId={source.id}
                  {...source}
                />
              </li>
            ))
          }
        </ul>
      </section>
    </details>

    {
      buildMode === "review" && (
        <ReviewDigestDisclosure
          scopeId={record.slug}
          recordId={record.id}
          contentDigest={contentDigest}
          renderedSetDigest={renderedSetDigest}
          followUpDigest={followUpEntry?.draftDigest}
        />
      )
    }

    <section class="case-section" aria-labelledby="related-heading">
      <h2 class="section-title" id="related-heading">相關影片</h2>
      <RelatedVideos matches={related} />
      {categoryLinks.length > 0 && <DetailCategories links={categoryLinks} />}
    </section>
  </article>
</BaseLayout>

<style>
  .case-heading {
    margin: 1rem 0;
  }
  .case-heading h1 {
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    margin: 0.4rem 0;
  }
  .case-facts {
    font-size: 0.85rem;
    color: var(--color-ink-muted);
  }
  .case-disclosure {
    border-top: 1px solid var(--hairline);
    padding: 0.75rem 0;
  }
  .case-disclosure > summary {
    cursor: pointer;
    padding: 0.6rem 0;
    font-weight: 600;
  }

  .case-detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    margin: var(--space-block) 0 0;
  }
  .case-video-segments {
    margin-block-start: 1rem;
  }
  .case-video-segments ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding-inline-start: 1.25rem;
  }

  @media (min-width: 64rem) {
    .case-detail-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .case-confirmation {
    display: inline-block;
    margin: 0.75rem 0 0;
    border: 1px solid var(--hairline);
    border-radius: 2px;
    padding: 2px 10px;
  }

  .case-confirmation[data-confirmation-status="confirmed"] {
    border-inline-start: 3px solid var(--color-brand-primary);
  }

  .case-classic {
    border-inline-start: 3px solid var(--color-metric);
    padding-inline-start: 0.75rem;
  }

  .mechanism-tags {
    margin-block-start: 1rem;
  }

  .case-section {
    margin-block-start: var(--space-section);
  }

  .source-list li {
    margin-bottom: 0.5rem;
  }
</style>
