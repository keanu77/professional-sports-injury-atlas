---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SituationNav from "../../components/atlas/SituationNav.astro";
import VideoDiscovery from "../../components/atlas/VideoDiscovery.astro";
import { videosBySituation } from "../../lib/videos/discovery";
import { observationClips } from "../../lib/videos/expansion";
import { hasPublicEmbed, videoFirstCases } from "../../lib/patient/featured";
import { isLaunchEnabled } from "../../lib/patient/public-launch";
import { permittedCasesForMode } from "../../lib/cases/pagination";
export async function getStaticPaths() {
  if (!isLaunchEnabled()) return [];
  const records = (await getCollection("cases")).map((entry) => entry.data);
  const groups = videosBySituation(
    videoFirstCases(permittedCasesForMode("public", records)).filter(
      hasPublicEmbed,
    ),
    observationClips(),
  );
  return groups.map((group) => ({
    params: { situation: group.code },
    props: { group, groups },
  }));
}
const { group, groups } = Astro.props;
---

<BaseLayout
  title={`${group.label}受傷影片｜運動傷害影片圖鑑`}
  description={`觀看${group.label}受傷影片，觀察動作過程，了解受傷當下與後續回場。`}
>
  <a href="/#situations">← 全部影片</a>
  <header class="part-heading">
    <h1>{group.label}受傷影片</h1><p>
      {group.count} 支影片 · 點選影片看受傷與回場重點
    </p>
  </header>
  <details class="other-categories">
    <summary>切換受傷情境</summary>
    <SituationNav situations={groups} current={group.code} />
  </details>
  <VideoDiscovery
    featured={group.cases}
    clips={group.clips}
    fixedSituation={group.code}
    scopeLabel={`${group.label}受傷影片`}
    heading={`搜尋${group.label}影片`}
  />
</BaseLayout>
<style>
  .part-heading {
    margin: 1.25rem 0 1rem;
  }
  h1 {
    font-family: var(--font-display);
  }
  .part-heading p {
    color: var(--color-ink-muted);
  }
  .other-categories {
    margin-block: 1rem;
  }
  summary {
    cursor: pointer;
    min-height: 44px;
    padding: 0.5rem;
  }
</style>
