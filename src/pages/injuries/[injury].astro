---
/**
 * Canonical injury route (listing page 1). It always exists for the three
 * registry injuries and renders the injury/course scope information, the
 * teaching overview (or the transparent `傷種教學待審查` state), a featured
 * case only when one exists, the first 12 case cards, the progressive filter
 * block, and semantic pagination links to the `/page/{n}/` routes.
 */
import { getCollection } from "astro:content";
import PatientGuide from "../../components/cases/PatientGuide.astro";
import CaseCard from "../../components/atlas/CaseCard.astro";
import CaseFilters from "../../components/atlas/CaseFilters.astro";
import EditorialHero from "../../components/atlas/EditorialHero.astro";
import EmptyState from "../../components/atlas/EmptyState.astro";
import ListingPagination from "../../components/atlas/ListingPagination.astro";
import RtpCourseLink from "../../components/cases/RtpCourseLink.astro";
import InjuryOverviewView from "../../components/injuries/InjuryOverview.astro";
import MedicalNotice from "../../components/notices/MedicalNotice.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { computeInjuryOverviewDigest } from "../../lib/cases/injury-overview-digest";
import courseLinksData from "../../data/professional-course-links.v1.json";
import courseSummariesData from "../../data/generated/rtp-course-summaries.v1.json";
import { findInjury } from "../../lib/contracts/taxonomy";
import {
  LISTING_PAGE_SIZE,
  paginateItems,
  permittedCasesForMode,
} from "../../lib/cases/pagination";
import { groupCasesByInjury } from "../../lib/cases/selectors";
import { resolveBuildMode } from "../../lib/governance/build-mode";
import {
  computeRenderedSetDigest,
  injuryListingPages,
  injuryRouteParams,
} from "../../lib/routes/static-paths";
import {
  professionalCourseLinksSchema,
  rtpCourseSummariesSchema,
} from "../../lib/rtp/course-links";
import { overviewImageFor } from "../../lib/ui/editorial-images";
import { isLaunchEnabled } from "../../lib/patient/public-launch";

export function getStaticPaths(): Array<{ params: { injury: string } }> {
  return injuryRouteParams().map((params) => ({ params }));
}

const { injury } = Astro.params;
const injuryCode = injury as string;
const buildMode = resolveBuildMode(process.env.ATLAS_BUILD_MODE);
const injuryLabel = findInjury(injuryCode)?.labelZh ?? injuryCode;
const bodyLibrary = {
  acl: { code: "knee", label: "膝蓋" },
  "ankle-sprain": { code: "ankle", label: "腳踝" },
  "achilles-rupture": { code: "calf-achilles", label: "小腿與阿基里斯腱" },
}[injuryCode as "acl" | "ankle-sprain" | "achilles-rupture"];

const caseRecords = (await getCollection("cases")).map((entry) => entry.data);
const overviewRecords = (await getCollection("injuries")).map(
  (entry) => entry.data,
);

const permitted = permittedCasesForMode(buildMode, caseRecords);
const injuryCases = groupCasesByInjury(permitted).get(injuryCode) ?? [];
const overview =
  overviewRecords.find((record) => record.injuryCode === injuryCode) ?? null;
const featuredCase = injuryCases.length > 0 ? injuryCases[0] : null;
const pageCases = paginateItems(injuryCases, LISTING_PAGE_SIZE)[0] ?? [];
const listingPages = injuryListingPages(buildMode, caseRecords, injuryCode);
const currentPage = listingPages[0];

const courseLinks = professionalCourseLinksSchema.parse(courseLinksData);
const courseSummaries = rtpCourseSummariesSchema.parse(courseSummariesData);
const injuryCourseLinks = courseLinks.links.filter(
  (link) => link.injuryCode === injuryCode,
);
const courseBySlug = new Map(
  courseSummaries.courses.map((course) => [course.slug, course]),
);
---

<BaseLayout
  title={`${injuryLabel}｜運動傷害影片圖鑑`}
  description={`${injuryLabel} 的教學總覽、已審查案例與課程範圍資訊。`}
  artifactRecordIds={pageCases.map((record) => record.id)}
  artifactDigest={overview === null
    ? computeRenderedSetDigest(injuryCases)
    : computeInjuryOverviewDigest(overview)}
  heroImage={overviewImageFor(injuryCode)}
  heroImageSizes="(min-width: 72rem) 72rem, calc(100vw - 2rem)"
>
  <div class="injury-page" data-injury-theme={injuryCode}>
    <MedicalNotice variant="compact" />
    <EditorialHero
      variant="injury"
      injuryCode={injuryCode}
      injuryLabel={injuryLabel}
      imageAlt={`${injuryLabel}匿名運動員運動醫學攝影意象；面孔不可見，不代表任何特定球員或真實受傷事件。`}
    >
      <span slot="eyebrow">傷種圖鑑</span>
      <h1 slot="title">{injuryLabel}</h1>
      <p slot="meta">
        {
          buildMode === "public"
            ? `${injuryCases.length} 支案例影片`
            : `已審查 ${injuryCases.length} 筆案例`
        }
      </p>
    </EditorialHero>

    <p class="injury-scope meta-row" data-injury-scope>
      {
        buildMode === "public"
          ? `${injuryLabel}衛教與 ${injuryCases.length} 支案例影片。`
          : `本頁整理 ${injuryLabel} 的教學總覽與已審查案例；目前共有 ${injuryCases.length} 筆已審查顯示案例（${injuryCases.length} reviewed cases）。`
      }
    </p>
    {
      isLaunchEnabled() && bodyLibrary && (
        <aside class="injury-library" aria-label="延伸影片庫">
          <p>
            本頁案例限於此傷種；同部位影片庫另收錄其他傷害、訪談與回場紀錄。
          </p>
          <a href={`/body-parts/${bodyLibrary.code}/`}>
            瀏覽{bodyLibrary.label}影片庫 <span aria-hidden="true">→</span>
          </a>
        </aside>
      )
    }

    {
      buildMode === "review" && (
        <div class="filter-shell">
          <CaseFilters buildMode={buildMode} scopeInjury={injuryCode} />
        </div>
      )
    }
    {
      buildMode === "public" && injuryCases.length === 0 && (
        <PatientGuide injuryCode={injuryCode} buildMode={buildMode} />
      )
    }

    <section
      class="injury-listing-section"
      aria-labelledby="listing-heading"
      data-static-listing
    >
      <h2 class="section-title" id="listing-heading">
        案例列表（第 {currentPage?.pageNumber ?? 1} 頁）
      </h2>
      {
        pageCases.length === 0 ? (
          <EmptyState
            title={
              buildMode === "public"
                ? "更多案例影片整理中"
                : "目前沒有已審查的案例"
            }
            description="真實案例完成來源、影片與診斷驗證並通過具名醫療審查後才會出現在這裡。"
            injuryCode={injuryCode}
            injuryLabel={injuryLabel}
          />
        ) : (
          <ol class="case-list">
            {pageCases.map((record) => (
              <li>
                <CaseCard
                  record={record}
                  showWorkflowBadge={buildMode === "review"}
                />
              </li>
            ))}
          </ol>
        )
      }
      {
        listingPages.length > 1 && currentPage !== undefined && (
          <ListingPagination
            currentPage={currentPage.pageNumber}
            nextPath={currentPage.nextPath}
          />
        )
      }
    </section>

    {
      (buildMode === "review" || injuryCases.length > 0) && (
        <PatientGuide injuryCode={injuryCode} buildMode={buildMode} />
      )
    }
    {
      buildMode === "review" && (
        <details class="injury-details">
          <summary>深入了解傷害與復健課程</summary>
          <section
            class="injury-content-section"
            aria-labelledby="overview-heading"
          >
            <h2 class="section-title" id="overview-heading">
              傷種教學總覽
            </h2>
            <InjuryOverviewView overview={overview} injuryLabel={injuryLabel} />
          </section>

          <section
            class="injury-content-section"
            aria-labelledby="course-scope-heading"
          >
            <h2 class="section-title" id="course-scope-heading">
              對應回場課程範圍
            </h2>
            {injuryCourseLinks.length === 0 ? (
              <EmptyState title="本傷種目前沒有對應的課程範圍資訊" />
            ) : (
              <div class="headline-list">
                {injuryCourseLinks.map((link) => {
                  const course = courseBySlug.get(link.catalogSlug);
                  return course === undefined ? null : (
                    <RtpCourseLink link={link} course={course} />
                  );
                })}
              </div>
            )}
          </section>

          {featuredCase !== null && (
            <section
              class="injury-content-section featured-case"
              aria-labelledby="featured-heading"
            >
              <h2 class="section-title" id="featured-heading">
                精選案例
              </h2>
              <CaseCard
                record={featuredCase}
                showWorkflowBadge={buildMode === "review"}
              />
            </section>
          )}
        </details>
      )
    }
  </div>
</BaseLayout>

<style>
  .injury-scope {
    margin: 1rem 0 0;
  }
  .injury-library {
    padding: 1rem 1.25rem;
    margin-block: 1rem;
    border-inline-start: 3px solid var(--color-brand-primary);
    background: var(--color-surface-raised);
  }
  .injury-library p {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: 0.9375rem;
  }
  .injury-library a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    font-weight: 600;
    text-underline-offset: 0.25em;
  }

  .filter-shell,
  .injury-listing-section,
  .injury-content-section {
    margin-block-start: var(--space-section);
  }

  .filter-shell {
    background: transparent;
  }

  .case-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(19rem, 100%), 1fr));
    gap: 2.5rem 1.5rem;
    margin: var(--space-block) 0 0;
    padding: 0;
    list-style: none;
  }

  .case-list > li {
    min-width: 0;
  }

  .featured-case :global(.case-card) {
    max-width: 28rem;
  }
</style>
