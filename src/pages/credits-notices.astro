---
/** Central, no-JavaScript credits and per-asset notice surface. */
import PhotoCredit from "../components/credits/PhotoCredit.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { CANONICAL_MEDICAL_NOTICE_ZH_HANT } from "../lib/medical-notice";
import { currentPhotoCredits } from "../lib/rights/photo-credits";
---

<BaseLayout
  title="授權與說明｜運動傷害影片圖鑑"
  description="影片、縮圖與歷史照片的來源及使用說明。"
>
  <h1>授權與說明</h1>
  <p>影片封面使用各支 YouTube 影片的預設縮圖，來源連結列於影片頁。</p>
  <section aria-labelledby="video-rights-heading">
    <h2 id="video-rights-heading">影片來源</h2>
    <p>
      本站使用來源平台提供的內嵌播放器，不下載、重製或重新上傳影片。影片權利屬原權利人，能播放不代表本站取得著作權授權；播放器可能因來源設定、地區或平台政策而停止提供。
    </p>
    <p>
      若來源停止允許內嵌，請使用案例中的原始影片連結。影片播放與字幕由來源平台提供。
    </p>
  </section>

  <section
    id="medical-notice"
    class="anchored-notice-section"
    aria-labelledby="medical-notice-heading"
  >
    <h2 id="medical-notice-heading">醫療內容聲明與法規脈絡</h2>
    <p data-canonical-medical-notice>
      {CANONICAL_MEDICAL_NOTICE_ZH_HANT}
    </p>
  </section>

  <details class="historical-credits">
    <summary>歷史人物照片的來源與授權紀錄</summary>
    <section aria-labelledby="photo-credits-heading">
      <h2 id="photo-credits-heading">歷史照片紀錄</h2>
      <p>
        保留 {currentPhotoCredits.length} 筆過去版本使用的人物照片紀錄，供來源追溯；目前影片封面已改用
        YouTube 預設縮圖。這些照片的授權不適用於影片或 YouTube 縮圖。
      </p>
      {
        currentPhotoCredits.map(({ selection }) => (
          <PhotoCredit selection={selection} />
        ))
      }
    </section>
  </details>
</BaseLayout>

<style>
  .anchored-notice-section {
    scroll-margin-block-start: 8rem;
  }
</style>
