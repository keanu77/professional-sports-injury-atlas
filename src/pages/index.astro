---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CaseCard from "../components/atlas/CaseCard.astro";
import InjuryCard from "../components/atlas/InjuryCard.astro";
import { INJURIES } from "../data/taxonomy/injuries";
import { permittedCasesForMode } from "../lib/cases/pagination";
import { resolveBuildMode } from "../lib/governance/build-mode";
import { computeRenderedSetDigest } from "../lib/routes/static-paths";
import { hasPublicEmbed, videoFirstCases } from "../lib/patient/featured";
import { findSport } from "../lib/contracts/taxonomy";
const buildMode = resolveBuildMode(process.env.ATLAS_BUILD_MODE);
const records = (await getCollection("cases")).map((entry) => entry.data);
const permitted = permittedCasesForMode(buildMode, records);
const featured = videoFirstCases(permitted).filter(hasPublicEmbed);
const availableInjuries = INJURIES.filter((injury) =>
  featured.some((record) => record.injury.code === injury.code),
);
const sports = [...new Set(featured.map((record) => record.sport.code))];
---

<BaseLayout
  title="運動傷害影片圖鑑｜看懂受傷，了解回場"
  description="從球員受傷影片，了解當下怎麼做、何時就醫與回場時間。"
  artifactRecordIds={permitted.map((record) => record.id)}
  artifactDigest={computeRenderedSetDigest(permitted)}
>
  <header class="video-intro">
    <p class="eyebrow">SPORTS INJURY / 從賽場到日常</p>
    <h1>看懂受傷，<br />了解回場。</h1>
    <p>先看影片，再看當下處理與回場時間。</p>
    <span class="intro-count">{featured.length} 支影片</span>
  </header>
  <section aria-labelledby="videos-heading" data-featured-videos>
    <div class="section-top">
      <h2 id="videos-heading">先看影片</h2><p>點選球員，進入案例播放</p>
    </div>
    <form class="video-filters" data-video-filters hidden>
      <label
        >傷害種類<select aria-label="傷害種類" name="injury"
          ><option value="">全部傷害</option>{
            availableInjuries.map((injury) => (
              <option value={injury.code}>{injury.labelZh}</option>
            ))
          }</select
        ></label
      >
      <label
        >運動項目<select aria-label="運動項目" name="sport"
          ><option value="">全部運動</option>{
            sports.map((code) => (
              <option value={code}>{findSport(code)?.labelZh ?? code}</option>
            ))
          }</select
        ></label
      >
      <label class="keyword-label"
        >找球員<input
          name="keyword"
          type="search"
          placeholder="球員或球隊"
        /></label
      >
    </form>
    <p class="filter-result" data-video-result aria-live="polite">
      {featured.length} 支影片
    </p>
    <ol class="video-grid">
      {
        featured.map((record, index) => (
          <li
            data-featured-card
            data-injury={record.injury.code}
            data-sport={record.sport.code}
            data-search={`${record.athlete.name} ${record.teamAtEvent.name}`}
          >
            <CaseCard
              record={record}
              showWorkflowBadge={false}
              compact
              priority={index === 0}
            />
          </li>
        ))
      }
    </ol>
    <p data-video-empty hidden>沒有符合的影片，試試其他關鍵字或選擇全部。</p>
  </section>
  <details class="more-cases">
    <summary>更多傷害與案例 <span>目前共 {permitted.length} 筆</span></summary
    ><div class="injury-feature-grid">
      {
        INJURIES.filter((injury) =>
          permitted.some((record) => record.injury.code === injury.code),
        ).map((injury) => (
          <InjuryCard
            injuryCode={injury.code}
            labelZh={injury.labelZh}
            reviewedCaseCount={
              permitted.filter((record) => record.injury.code === injury.code)
                .length
            }
          />
        ))
      }
    </div><p data-total-reviewed-count>
      {permitted.length} 筆案例（{permitted.length} reviewed cases）。
    </p>
  </details>
  <p class="home-note">
    影片呈現受傷過程；診斷依具名來源。球員的回場紀錄不等於你的恢復時間。
  </p>
</BaseLayout>
<script>
  const form = document.querySelector<HTMLFormElement>("[data-video-filters]");
  if (form) {
    form.hidden = false;
    const cards = [
      ...document.querySelectorAll<HTMLElement>("[data-featured-card]"),
    ];
    const update = () => {
      const data = new FormData(form);
      const injury = String(data.get("injury") ?? "");
      const sport = String(data.get("sport") ?? "");
      const keyword = String(data.get("keyword") ?? "")
        .trim()
        .toLocaleLowerCase();
      let count = 0;
      for (const card of cards) {
        card.hidden = !!(
          (injury && card.dataset.injury !== injury) ||
          (sport && card.dataset.sport !== sport) ||
          !(card.dataset.search ?? "").toLocaleLowerCase().includes(keyword)
        );
        if (!card.hidden) count++;
      }
      const result = document.querySelector("[data-video-result]");
      if (result) result.textContent = `${count} 支影片`;
      const empty = document.querySelector<HTMLElement>("[data-video-empty]");
      if (empty) empty.hidden = count !== 0;
    };
    form.addEventListener("input", update);
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      update();
    });
  }
</script>
<style>
  .video-intro {
    padding: clamp(1.5rem, 5vw, 3.5rem) 0 2rem;
    border-bottom: 1px solid var(--hairline);
    position: relative;
  }
  h1 {
    font: 700 clamp(2.2rem, 5vw, 4rem)/1.15 var(--font-heading);
    letter-spacing: -0.025em;
    margin: 0.7rem 0 1rem;
  }
  .video-intro > p:not(.eyebrow) {
    color: var(--color-ink-muted);
    margin: 0;
  }
  .intro-count {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--color-ink-muted);
  }
  .section-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    margin: 1.5rem 0 1rem;
  }
  .section-top h2 {
    margin: 0;
  }
  .section-top p,
  .home-note,
  .filter-result {
    color: var(--color-ink-muted);
    font-size: 0.875rem;
  }
  .video-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .video-filters[hidden] {
    display: none;
  }
  label {
    display: grid;
    gap: 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
  }
  select,
  input {
    background: var(--color-surface-raised);
    color: var(--color-ink);
    border: 1px solid var(--hairline-strong);
    border-radius: 4px;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    font: inherit;
  }
  .keyword-label {
    flex: 1;
    min-width: 10rem;
  }
  .video-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    padding: 0;
    list-style: none;
  }
  .more-cases {
    margin-top: 2.5rem;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    padding: 1rem 0;
  }
  summary {
    cursor: pointer;
    font-weight: 600;
    padding: 0.5rem 0;
  }
  summary span {
    font-size: 0.8rem;
    color: var(--color-ink-muted);
    margin-left: 1rem;
  }
  .injury-feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    padding-block: 1rem;
  }
  .home-note {
    margin-block: 1.5rem;
  }
  @media (max-width: 60rem) {
    .video-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 40rem) {
    .video-grid,
    .injury-feature-grid {
      grid-template-columns: 1fr;
    }
    .video-intro {
      padding-top: 1rem;
    }
    .video-intro h1 br {
      display: none;
    }
  }
</style>
