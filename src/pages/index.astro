---
import BodyPartNav from "../components/atlas/BodyPartNav.astro";
import { videosByBodyPart } from "../lib/videos/body-parts";
import { isLaunchEnabled } from "../lib/patient/public-launch";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { observationClips } from "../lib/videos/expansion";
import ObservationCard from "../components/atlas/ObservationCard.astro";
import CaseCard from "../components/atlas/CaseCard.astro";
import InjuryCard from "../components/atlas/InjuryCard.astro";
import { INJURIES } from "../data/taxonomy/injuries";
import { permittedCasesForMode } from "../lib/cases/pagination";
import { resolveBuildMode } from "../lib/governance/build-mode";
import { computeRenderedSetDigest } from "../lib/routes/static-paths";
import { hasPublicEmbed, videoFirstCases } from "../lib/patient/featured";
const buildMode = resolveBuildMode(process.env.ATLAS_BUILD_MODE);
const records = (await getCollection("cases")).map((entry) => entry.data);
const permitted = permittedCasesForMode(buildMode, records);
const featured = videoFirstCases(permitted).filter(hasPublicEmbed);
const clips = observationClips();
---

<BaseLayout
  title="運動傷害影片圖鑑｜看懂受傷，了解回場"
  description="從運動受傷影片，了解當下怎麼做、何時就醫與回場時間。"
  artifactRecordIds={permitted.map((record) => record.id)}
  artifactDigest={computeRenderedSetDigest(permitted)}
>
  <header class="video-intro">
    <nav class="content-trail" aria-label="麵包屑">
      <a href="https://sportsmedicine.tw/content/">分享資訊</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">影片圖鑑</span>
    </nav>
    <h1>運動傷害影片圖鑑</h1>
    <p>從受傷當下到重返運動，用影片了解運動傷害。</p>
  </header>
  {
    isLaunchEnabled() && (
      <div id="body-parts">
        <BodyPartNav parts={videosByBodyPart(featured, clips)} />
      </div>
    )
  }
  <section id="videos-heading" aria-label="運動傷害影片" data-featured-videos>
    <ol class="video-grid">
      {
        featured.map((record, index) => (
          <li data-featured-card>
            <CaseCard
              record={record}
              showWorkflowBadge={false}
              compact
              priority={index === 0}
            />
          </li>
        ))
      }
      {
        clips.map((clip) => (
          <li data-featured-card>
            <ObservationCard clip={clip} />
          </li>
        ))
      }
    </ol>
  </section>
  <details class="more-cases">
    <summary
      >更多傷害與案例 <span
        >{permitted.length} 則案例 · {clips.length} 則動作觀察</span
      ></summary
    ><div class="injury-feature-grid">
      {
        INJURIES.filter((injury) =>
          permitted.some((record) => record.injury.code === injury.code),
        ).map((injury) => (
          <InjuryCard
            injuryCode={injury.code}
            labelZh={injury.labelZh}
            reviewedCaseCount={
              permitted.filter((record) => record.injury.code === injury.code)
                .length
            }
          />
        ))
      }
    </div><p data-total-reviewed-count>
      {
        buildMode === "review"
          ? `${permitted.length} 筆案例（${permitted.length} reviewed cases）。`
          : `${permitted.length} 則案例影片`
      }
    </p>
  </details>
  <p class="home-note">
    影片呈現受傷過程；診斷依具名來源。球員的回場紀錄不等於你的恢復時間。
  </p>
</BaseLayout>
<style>
  .video-intro {
    margin: -1.5rem calc(50% - 50vw) 4rem;
    padding: 4rem max(1.5rem, calc((100vw - 77rem) / 2));
    background: linear-gradient(
      135deg,
      var(--color-brand-50),
      var(--color-surface)
    );
  }
  .content-trail {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    align-items: center;
    font-size: 0.875rem;
    color: var(--color-ink-muted);
  }
  .content-trail a {
    text-decoration: none;
  }
  .content-trail [aria-current] {
    color: var(--color-brand-primary);
  }
  h1 {
    font: 700 clamp(2.25rem, 4vw, 3rem)/1.3 var(--font-display);
    margin: 1rem 0;
    letter-spacing: -0.025em;
  }
  .video-intro > p {
    font-size: 1.125rem;
    color: var(--color-ink-muted);
    margin: 0;
    max-width: 42rem;
  }
  .video-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .more-cases {
    margin-top: 2.5rem;
    border-block: 1px solid var(--hairline);
    padding: 1rem 0;
  }
  summary {
    cursor: pointer;
    font-weight: 600;
    padding: 0.5rem 0;
  }
  summary span {
    font-size: 0.8rem;
    color: var(--color-ink-muted);
    margin-left: 1rem;
  }
  .injury-feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    padding-block: 1rem;
  }
  .home-note {
    color: var(--color-ink-muted);
    font-size: 0.875rem;
    margin-block: 1.5rem;
  }
  @media (max-width: 60rem) {
    .video-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 40rem) {
    .video-grid,
    .injury-feature-grid {
      grid-template-columns: 1fr;
    }
    .video-intro {
      padding: 2.5rem 1rem;
      margin-bottom: 2.5rem;
    }
  }
</style>
