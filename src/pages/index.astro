---
import { Picture } from "astro:assets";
import heroImage from "../assets/hero/a-v2-fluid-burst.png";
import VideoDiscovery from "../components/atlas/VideoDiscovery.astro";
import FollowLinks from "../components/layout/FollowLinks.astro";
import SituationNav from "../components/atlas/SituationNav.astro";
import VideoTypeNav from "../components/atlas/VideoTypeNav.astro";
import { videosBySituation } from "../lib/videos/discovery";
import SportNav from "../components/atlas/SportNav.astro";
import { videosBySport } from "../lib/videos/sports";
import BodyPartNav from "../components/atlas/BodyPartNav.astro";
import { videosByBodyPart } from "../lib/videos/body-parts";
import { nerveInjuryGroup } from "../lib/videos/nerve-categories";
import { contentTypeGroups } from "../lib/videos/content-types";
import { isLaunchEnabled } from "../lib/patient/public-launch";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { observationClips } from "../lib/videos/expansion";
import { permittedCasesForMode } from "../lib/cases/pagination";
import { resolveBuildMode } from "../lib/governance/build-mode";
import { computeRenderedSetDigest } from "../lib/routes/static-paths";
import { hasPublicEmbed, videoFirstCases } from "../lib/patient/featured";
const buildMode = resolveBuildMode(process.env.ATLAS_BUILD_MODE);
const records = (await getCollection("cases")).map((entry) => entry.data);
const permitted = permittedCasesForMode(buildMode, records);
const featured = videoFirstCases(permitted).filter(hasPublicEmbed);
const clips = observationClips();
const bodyParts = videosByBodyPart(featured, clips);
const sports = videosBySport(featured, clips);
const situations = videosBySituation(featured, clips);
const nerveGroup = nerveInjuryGroup(clips);
const videoTypes = contentTypeGroups(featured, clips);
const videoCount = featured.length + clips.length;
---

<BaseLayout
  title="運動傷害影片圖鑑｜看懂受傷，了解回場"
  description="從運動受傷影片，了解當下怎麼做、何時就醫與回場時間。"
  artifactRecordIds={permitted.map((record) => record.id)}
  artifactDigest={computeRenderedSetDigest(permitted)}
>
  <header class="video-intro">
    <div class="video-intro-inner">
      <div class="home-intro-topline">
        <nav class="content-trail" aria-label="麵包屑">
          <a href="https://sportsmedicine.tw/content/">分享資訊</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">影片圖鑑</span>
        </nav>
        <FollowLinks placement="home" />
      </div>
      <div class="home-hero-stage">
        <div class="home-hero-art" aria-hidden="true">
          <Picture
            src={heroImage}
            formats={["avif"]}
            fallbackFormat="webp"
            widths={[480, 640, 960, 1280, 1672]}
            sizes="(max-width: 40rem) 80vw, (min-width: 77rem) 48rem, 58vw"
            quality={72}
            alt=""
            loading="eager"
            decoding="async"
            fetchpriority="high"
            class="home-hero-image"
            pictureAttributes={{ class: "home-hero-picture" }}
          />
        </div>
        <div class="home-hero-copy">
          <p class="home-hero-eyebrow">看懂受傷，了解回場</p>
          <h1>運動傷害影片圖鑑</h1>
          <p class="home-hero-intro">
            從真實賽事、訪談與解說，認識運動傷害與選手回場歷程。
          </p>
          <dl class="atlas-stats" aria-label="目前收錄內容">
            <div>
              <dt>受傷部位</dt>
              <dd>
                <strong data-atlas-stat="body-parts">{bodyParts.length}</strong
                ><span>個</span>
              </dd>
            </div>
            <div>
              <dt>收錄影片</dt>
              <dd>
                <strong data-atlas-stat="videos">{videoCount}</strong><span
                  >支</span
                >
              </dd>
            </div>
            <div>
              <dt>運動項目</dt>
              <dd>
                <strong data-atlas-stat="sports">{sports.length}</strong><span
                  >種</span
                >
              </dd>
            </div>
          </dl>
          <div class="home-hero-actions">
            <a class="home-video-cta" href="#videos-heading">開始找影片</a>
            <a class="home-video-secondary" href="/video-types/injury-moment/"
              >看受傷瞬間 <span aria-hidden="true">↗</span></a
            >
          </div>
        </div>
        <small class="home-hero-caption">AI 合成情境圖 · 非實際賽事畫面</small>
      </div>
    </div>
  </header>
  <VideoDiscovery featured={featured} clips={clips}>
    {
      isLaunchEnabled() && (
        <section class="home-categories" data-home-categories>
          <div
            class="home-category-controls"
            data-home-category-controls
            hidden
            aria-label="選擇影片分類"
          >
            <button
              type="button"
              data-home-category-select="body-parts"
              aria-expanded="true"
              aria-controls="home-category-body-parts"
            >
              依受傷部位
            </button>
            <button
              type="button"
              data-home-category-select="sports"
              aria-expanded="false"
              aria-controls="home-category-sports"
            >
              依運動項目
            </button>
            <button
              type="button"
              data-home-category-select="situations"
              aria-expanded="false"
              aria-controls="home-category-situations"
            >
              依受傷情境
            </button>
            <button
              type="button"
              data-home-category-select="video-types"
              aria-expanded="false"
              aria-controls="home-category-video-types"
            >
              依影片類型
            </button>
          </div>
          <div
            id="home-category-body-parts"
            data-home-category-panel="body-parts"
          >
            <div id="body-parts">
              <BodyPartNav parts={bodyParts} nerveCount={nerveGroup.count} />
            </div>
          </div>
          <div
            id="home-category-video-types"
            data-home-category-panel="video-types"
          >
            <div id="video-types">
              <VideoTypeNav types={videoTypes} />
            </div>
          </div>
          <div id="home-category-sports" data-home-category-panel="sports">
            <div id="sports">
              <SportNav sports={sports} />
            </div>
          </div>
          <div
            id="home-category-situations"
            data-home-category-panel="situations"
          >
            <div id="situations">
              <SituationNav situations={situations} />
            </div>
          </div>
        </section>
      )
    }
  </VideoDiscovery>
  <p class="home-note">
    影片可能呈現賽事、反應、訪談或回場紀錄；診斷依具名來源。球員的回場紀錄不等於你的恢復時間。
  </p>
</BaseLayout>
<script>
  import "../scripts/home-categories";
  import "../scripts/video-discovery";
</script>
<style>
  [hidden] {
    display: none !important;
  }
  .home-video-cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.65rem 1rem;
    border-radius: 999px;
    background: var(--color-brand-primary);
    color: var(--color-on-brand);
    font-weight: 600;
    text-decoration: none;
  }
  .home-video-secondary {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-brand-primary);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
  }
  .home-video-secondary span {
    margin-inline-start: 0.35rem;
  }
  .home-categories {
    margin-block: 1.25rem;
  }
  .home-category-controls:not([hidden]) {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .home-category-controls {
    gap: 0.5rem;
    margin-block-end: 1rem;
  }
  .home-category-controls button {
    min-height: 44px;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--color-brand-100);
    border-radius: 999px;
    background: var(--color-surface-raised);
    color: var(--color-brand-primary);
    font: inherit;
    font-weight: 600;
  }
  .home-category-controls button[aria-expanded="true"] {
    border-color: var(--color-brand-primary);
    background: var(--color-brand-primary);
    color: var(--color-on-brand);
  }
  .video-intro {
    color-scheme: dark;
    margin: -1.5rem calc(50% - 50vw) 1.5rem;
    background: linear-gradient(
      135deg,
      var(--color-brand-50),
      var(--color-surface)
    );
    overflow: hidden;
  }
  .video-intro-inner {
    max-width: 77rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }
  .home-intro-topline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    min-height: 4.5rem;
  }
  @media (max-width: 40rem) {
    .home-intro-topline {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  .content-trail {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    align-items: center;
    font-size: 0.875rem;
    color: var(--color-ink-muted);
  }
  .content-trail a {
    text-decoration: none;
  }
  .content-trail [aria-current] {
    color: var(--color-brand-primary);
  }
  .home-hero-stage {
    position: relative;
    min-height: 20.5rem;
    isolation: isolate;
  }
  .home-hero-art {
    position: absolute;
    z-index: -2;
    inset: 0 0 0 34%;
  }
  .home-hero-art::after {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        var(--color-brand-50) 0%,
        color-mix(in srgb, var(--color-brand-50) 86%, transparent) 17%,
        transparent 48%
      ),
      linear-gradient(
        0deg,
        var(--color-brand-50),
        transparent 18%,
        transparent 88%,
        var(--color-brand-50)
      );
    content: "";
    pointer-events: none;
  }
  .home-hero-art :global(.home-hero-picture) {
    position: absolute;
    inset: 0;
    display: block;
  }
  .home-hero-art :global(.home-hero-image) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: right center;
  }
  .home-hero-copy {
    position: relative;
    z-index: 1;
    width: min(52%, 38rem);
    padding-block: 1.2rem 2rem;
  }
  .home-hero-eyebrow {
    margin: 0 0 0.35rem;
    color: var(--color-brand-primary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }
  h1 {
    font: 700 clamp(2.25rem, 4vw, 3rem)/1.3 var(--font-display);
    margin: 0 0 0.7rem;
    letter-spacing: -0.025em;
  }
  .home-hero-intro {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-ink-muted);
    margin: 0;
    max-width: 31rem;
  }
  .atlas-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    max-width: 32rem;
    margin: 1rem 0;
  }
  .atlas-stats > div {
    border-block-start: 2px solid var(--color-brand-primary);
    padding-block-start: 0.75rem;
  }
  .atlas-stats dt {
    font-size: 0.875rem;
    color: var(--color-ink-muted);
  }
  .atlas-stats dd {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem;
    margin: 0.25rem 0 0;
    color: var(--color-ink);
  }
  .atlas-stats strong {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
  }
  .atlas-stats span {
    font-size: 0.875rem;
    color: var(--color-ink-muted);
  }
  .home-hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.1rem;
  }
  .home-hero-caption {
    position: absolute;
    right: 0;
    bottom: 0.65rem;
    z-index: 1;
    padding: 0.2rem 0.45rem;
    border-radius: 0.25rem;
    background: color-mix(in srgb, var(--color-surface) 82%, transparent);
    color: var(--color-ink-muted);
    font-size: 0.6875rem;
  }
  .home-note {
    color: var(--color-ink-muted);
    font-size: 0.875rem;
    margin-block: 1.5rem;
  }
  @media (max-width: 40rem) {
    .home-category-controls:not([hidden]) {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding-block: 0.25rem;
    }
    .home-category-controls button {
      flex: 0 0 auto;
    }
    .video-intro {
      margin-bottom: 1.75rem;
    }
    .video-intro-inner {
      padding-inline: 1rem;
    }
    .home-intro-topline {
      min-height: auto;
      padding-block: 0.75rem;
    }
    .home-hero-stage {
      min-height: 18.25rem;
    }
    .home-hero-art {
      inset: 0 -1rem auto 20%;
      height: 11.25rem;
      opacity: 0.72;
    }
    .home-hero-art::after {
      background:
        linear-gradient(
          90deg,
          var(--color-brand-50),
          color-mix(in srgb, var(--color-brand-50) 62%, transparent) 30%,
          transparent 85%
        ),
        linear-gradient(0deg, var(--color-brand-50), transparent 72%);
    }
    .home-hero-art :global(.home-hero-image) {
      object-position: right top;
    }
    .home-hero-copy {
      width: 100%;
      padding-block: 0.7rem 1.8rem;
    }
    .home-hero-eyebrow {
      max-width: 55%;
      font-size: 0.6875rem;
    }
    h1 {
      max-width: 70%;
      font-size: clamp(1.75rem, 9vw, 2.25rem);
      line-height: 1.25;
    }
    .home-hero-intro {
      font-size: 0.9375rem;
      line-height: 1.6;
      text-shadow: 0 1px 10px var(--color-brand-50);
    }
    .atlas-stats {
      gap: 0.65rem;
      margin-block: 0.85rem;
    }
    .atlas-stats > div {
      padding-block-start: 0.45rem;
    }
    .atlas-stats dt,
    .atlas-stats span {
      font-size: 0.75rem;
    }
    .atlas-stats strong {
      font-size: clamp(1.4rem, 7vw, 1.8rem);
    }
    .home-video-cta,
    .home-video-secondary {
      font-size: 0.8125rem;
    }
    .home-hero-caption {
      right: 0;
      bottom: 0.45rem;
      font-size: 0.625rem;
    }
  }
</style>
