---
/**
 * Governed base layout. It resolves the build mode once, emits the exact
 * review robots meta on every HTML page in review mode, and renders the
 * accessible site chrome: skip link, single main landmark, text-only header
 * identity, review banner, and footer. An inline script applies the locally
 * stored theme (light default, manual dark) and font scale (0.875-1.5)
 * before first paint. Canonical metadata is emitted only when governance
 * records an authorized public site URL (currently none). Review builds
 * emit no sitemap, analytics, third-party iframe, or external preconnect;
 * fonts load only from local static assets and pinned @fontsource packages.
 */
import "@fontsource/barlow-condensed/latin-600.css";
import "@fontsource/fraunces/latin-700.css";
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-600.css";
import { getImage } from "astro:assets";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/layout.css";
import "../styles/components.css";
import ReviewBanner from "../components/layout/ReviewBanner.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import governance from "../data/site-governance.v1.json";
import { isLaunchEnabled, launchApproval } from "../lib/patient/public-launch";
import {
  resolveBuildMode,
  robotsMetaContent,
} from "../lib/governance/build-mode";
import {
  ARTIFACT_IDENTITY_META_NAME,
  encodeArtifactIdentity,
} from "../lib/governance/artifact-manifest";
import { compareCodePoints } from "../lib/contracts/canonical";
import {
  CASE_HERO_QUALITY,
  caseHeroWidthsFor,
} from "../lib/ui/image-renditions";

interface Props {
  title: string;
  description?: string;
  artifactRecordIds?: readonly string[];
  artifactDigest?: string | null;
  heroImage?: ImageMetadata;
  heroImageMode?: "band" | "case";
  heroImageSizes?: string;
}

const {
  title,
  description,
  artifactRecordIds = [],
  artifactDigest = null,
  heroImage,
  heroImageMode = "band",
  heroImageSizes = "(min-width: 72rem) 72rem, 100vw",
} = Astro.props;
const buildMode = resolveBuildMode(process.env.ATLAS_BUILD_MODE);
const robotsContent = robotsMetaContent(buildMode);
const sortedArtifactRecordIds = [...artifactRecordIds].sort(compareCodePoints);
if (
  sortedArtifactRecordIds.some(
    (recordId, index) =>
      index > 0 && recordId === sortedArtifactRecordIds[index - 1],
  )
) {
  throw new Error("artifact identity record IDs must be unique");
}
const artifactIdentity =
  buildMode === "review"
    ? encodeArtifactIdentity({
        kind: "html-page",
        pageIds: [Astro.url.pathname],
        recordIds: sortedArtifactRecordIds,
        digest: artifactDigest,
        shardIds: [],
      })
    : null;

const publicSiteUrl: string | null = isLaunchEnabled()
  ? launchApproval.origin
  : governance.publicSiteUrl;
const canonicalUrl =
  publicSiteUrl !== null &&
  (isLaunchEnabled() ||
    governance.indexingAuthorization.status === "authorized")
    ? new URL(Astro.url.pathname, publicSiteUrl).href
    : null;

const bandPreloadWidths = [480, 720, 768, 840, 960, 1280, 1600, 2400];
const casePreloadWidths =
  heroImage === undefined ||
  heroImageMode !== "case" ||
  heroImage.format === "svg"
    ? []
    : caseHeroWidthsFor(heroImage.width);
const casePreloadWidth = casePreloadWidths.at(-1);
const bandPreloads =
  heroImage === undefined || heroImageMode !== "band"
    ? []
    : await Promise.all(
        bandPreloadWidths.map((width) =>
          getImage({ src: heroImage, width, format: "avif", quality: 60 }),
        ),
      );
const casePreload =
  heroImage === undefined ||
  heroImageMode !== "case" ||
  heroImage.format === "svg" ||
  casePreloadWidth === undefined
    ? null
    : await getImage({
        src: heroImage,
        width: casePreloadWidth,
        widths: casePreloadWidths,
        format: "avif",
        quality: CASE_HERO_QUALITY,
      });
---

<!doctype html>
<html lang="zh-Hant" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {robotsContent !== null && <meta name="robots" content={robotsContent} />}
    {
      artifactIdentity !== null && (
        <meta name={ARTIFACT_IDENTITY_META_NAME} content={artifactIdentity} />
      )
    }
    <title>{title}</title>
    {
      description !== undefined && (
        <meta name="description" content={description} />
      )
    }
    {canonicalUrl !== null && <link rel="canonical" href={canonicalUrl} />}
    {
      bandPreloads.length > 0 && (
        <link
          rel="preload"
          as="image"
          type="image/avif"
          href={bandPreloads.at(-1)!.src}
          imagesrcset={bandPreloads
            .map(
              (rendition, index) =>
                `${rendition.src} ${bandPreloadWidths[index]}w`,
            )
            .join(", ")}
          imagesizes={heroImageSizes}
          fetchpriority="high"
        />
      )
    }
    {
      casePreload !== null && (
        <link
          rel="preload"
          as="image"
          type="image/avif"
          href={casePreload.src}
          imagesrcset={casePreload.srcSet.attribute}
          imagesizes={heroImageSizes}
          fetchpriority="high"
        />
      )
    }
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let theme = "light";
        let scale = 1;
        try {
          if (window.localStorage.getItem("atlas-theme") === "dark") {
            theme = "dark";
          }
          const raw = Number.parseFloat(
            window.localStorage.getItem("atlas-font-scale") ?? "1",
          );
          if (Number.isFinite(raw)) {
            scale = Math.min(1.5, Math.max(0.875, raw));
          }
        } catch {
          /* Storage unavailable: keep the light/normal defaults. */
        }
        root.dataset.theme = theme;
        root.dataset.fontScale = String(scale);
        root.style.setProperty("--font-scale", String(scale));
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳至主要內容</a>
    <ReviewBanner buildMode={buildMode} />
    <div class="header-sentinel" data-header-sentinel aria-hidden="true"></div>
    <SiteHeader />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import { initSiteChrome } from "../scripts/preferences";

      initSiteChrome();
    </script>
  </body>
</html>
