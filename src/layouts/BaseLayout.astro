---
/**
 * Governed base layout. It resolves the build mode once, emits the exact
 * review robots meta on every HTML page in review mode, and renders the
 * accessible site chrome: skip link, single main landmark, text-only header
 * identity, review banner, and footer. An inline script applies the locally
 * stored theme (light default, manual dark) and font scale (0.875-1.5)
 * before first paint through a parser-blocking same-origin script. Canonical
 * metadata is emitted only when governance records an authorized public site
 * URL (currently none). Review builds
 * emit no sitemap, analytics, third-party iframe, or external preconnect;
 * fonts load only from local static assets and pinned @fontsource packages.
 */
import "@fontsource/barlow-condensed/latin-600.css";
import "@fontsource/fraunces/latin-700.css";
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-600.css";
import { getImage } from "astro:assets";
import homeAtlas from "../assets/heroes/home-atlas.png";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/layout.css";
import "../styles/components.css";
import ReviewBanner from "../components/layout/ReviewBanner.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import governance from "../data/site-governance.v1.json";
import { isLaunchEnabled } from "../lib/patient/public-launch";
import { publicDomain } from "../lib/patient/public-domain";
import {
  resolveBuildMode,
  robotsMetaContent,
} from "../lib/governance/build-mode";
import {
  ARTIFACT_IDENTITY_META_NAME,
  encodeArtifactIdentity,
} from "../lib/governance/artifact-manifest";
import { compareCodePoints } from "../lib/contracts/canonical";
import {
  CASE_HERO_QUALITY,
  caseHeroWidthsFor,
} from "../lib/ui/image-renditions";

interface Props {
  title: string;
  description?: string;
  artifactRecordIds?: readonly string[];
  artifactDigest?: string | null;
  heroImage?: ImageMetadata;
  heroImageMode?: "band" | "case";
  heroImageSizes?: string;
}

const {
  title,
  description = "運動傷害影片圖鑑整理受傷影片、當下處置與公開回場紀錄。",
  artifactRecordIds = [],
  artifactDigest = null,
  heroImage,
  heroImageMode = "band",
  heroImageSizes = "(min-width: 72rem) 72rem, 100vw",
} = Astro.props;
const buildMode = resolveBuildMode(process.env.ATLAS_BUILD_MODE);
const robotsContent = robotsMetaContent(buildMode);
const sortedArtifactRecordIds = [...artifactRecordIds].sort(compareCodePoints);
if (
  sortedArtifactRecordIds.some(
    (recordId, index) =>
      index > 0 && recordId === sortedArtifactRecordIds[index - 1],
  )
) {
  throw new Error("artifact identity record IDs must be unique");
}
const artifactIdentity =
  buildMode === "review"
    ? encodeArtifactIdentity({
        kind: "html-page",
        pageIds: [Astro.url.pathname],
        recordIds: sortedArtifactRecordIds,
        digest: artifactDigest,
        shardIds: [],
      })
    : null;

const publicSiteUrl: string | null = isLaunchEnabled()
  ? publicDomain.origin
  : governance.publicSiteUrl;
const canonicalUrl =
  publicSiteUrl !== null &&
  (isLaunchEnabled() ||
    governance.indexingAuthorization.status === "authorized")
    ? new URL(Astro.url.pathname, publicSiteUrl).href
    : null;
const defaultShareImage =
  canonicalUrl === null
    ? null
    : await getImage({
        src: homeAtlas,
        width: 1200,
        height: 630,
        fit: "cover",
        format: "png",
      });
const shareImageUrl =
  canonicalUrl === null || defaultShareImage === null
    ? null
    : new URL(defaultShareImage.src, canonicalUrl).href;

const bandPreloadWidths = [480, 720, 768, 840, 960, 1280, 1600, 2400];
const casePreloadWidths =
  heroImage === undefined ||
  heroImageMode !== "case" ||
  heroImage.format === "svg"
    ? []
    : caseHeroWidthsFor(heroImage.width);
const casePreloadWidth = casePreloadWidths.at(-1);
const bandPreloads =
  heroImage === undefined || heroImageMode !== "band"
    ? []
    : await Promise.all(
        bandPreloadWidths.map((width) =>
          getImage({ src: heroImage, width, format: "avif", quality: 60 }),
        ),
      );
const casePreload =
  heroImage === undefined ||
  heroImageMode !== "case" ||
  heroImage.format === "svg" ||
  casePreloadWidth === undefined
    ? null
    : await getImage({
        src: heroImage,
        width: casePreloadWidth,
        widths: casePreloadWidths,
        format: "avif",
        quality: CASE_HERO_QUALITY,
      });
---

<!doctype html>
<html
  lang="zh-Hant"
  data-theme="light"
  data-playback-statistics={buildMode === "public" && isLaunchEnabled()
    ? "enabled"
    : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {robotsContent !== null && <meta name="robots" content={robotsContent} />}
    {
      artifactIdentity !== null && (
        <meta name={ARTIFACT_IDENTITY_META_NAME} content={artifactIdentity} />
      )
    }
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalUrl !== null && <link rel="canonical" href={canonicalUrl} />}
    {
      canonicalUrl !== null && shareImageUrl !== null && (
        <>
          <meta property="og:type" content="website" />
          <meta property="og:locale" content="zh_TW" />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonicalUrl} />
          <meta property="og:image" content={shareImageUrl} />
          <meta property="og:image:alt" content="運動傷害影片圖鑑" />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={title} />
          <meta name="twitter:description" content={description} />
          <meta name="twitter:url" content={canonicalUrl} />
          <meta name="twitter:image" content={shareImageUrl} />
          <meta name="twitter:image:alt" content="運動傷害影片圖鑑" />
        </>
      )
    }
    {
      bandPreloads.length > 0 && (
        <link
          rel="preload"
          as="image"
          type="image/avif"
          href={bandPreloads.at(-1)!.src}
          imagesrcset={bandPreloads
            .map(
              (rendition, index) =>
                `${rendition.src} ${bandPreloadWidths[index]}w`,
            )
            .join(", ")}
          imagesizes={heroImageSizes}
          fetchpriority="high"
        />
      )
    }
    {
      casePreload !== null && (
        <link
          rel="preload"
          as="image"
          type="image/avif"
          href={casePreload.src}
          imagesrcset={casePreload.srcSet.attribute}
          imagesizes={heroImageSizes}
          fetchpriority="high"
        />
      )
    }
    <script is:inline src="/preferences-init.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳至主要內容</a>
    <ReviewBanner buildMode={buildMode} />
    <div class="header-sentinel" data-header-sentinel aria-hidden="true"></div>
    <SiteHeader />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import { initSiteChrome } from "../scripts/preferences";

      initSiteChrome();
    </script>
  </body>
</html>
