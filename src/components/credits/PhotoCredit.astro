---
/** Complete, registry-derived credit row for one governed Commons asset. */
import type { PlayerPhotoSelectionV7 } from "../../lib/contracts/player-photo-registry-v7";
import { photoCreditPresentation } from "../../lib/rights/photo-credits";

interface Props {
  selection: PlayerPhotoSelectionV7;
}

const credit = photoCreditPresentation(Astro.props.selection);
const { selection } = credit;
const { rightsAttribution } = selection;
const noticeFields = [
  {
    field: "copyright-notice",
    label: "著作權聲明",
    notice: credit.notices.copyright,
  },
  {
    field: "disclaimer-notice",
    label: "來源免責通知",
    notice: credit.notices.disclaimer,
  },
  {
    field: "other-notice",
    label: "其他逐檔通知",
    notice: credit.notices.other,
  },
] as const;
---

<article
  id={credit.anchorId}
  class="photo-credit"
  data-asset-credit-row
  data-athlete-name={selection.athleteName}
  data-license-bucket={rightsAttribution.licenseBucket}
  data-source-revision-id={String(selection.sourceRevision.id)}
  data-policy-version={credit.policyVersion}
>
  <h2>{selection.athleteName}</h2>
  <dl>
    <div data-credit-field="creator">
      <dt>{credit.creatorLabel}</dt>
      <dd>{credit.creditText}</dd>
    </div>
    <div
      data-credit-field="work-title"
      data-work-title-status={rightsAttribution.workTitle.status}
    >
      <dt>作品標題</dt>
      <dd>
        {
          credit.workTitleText === null
            ? "目前來源未提供"
            : `〈${credit.workTitleText}〉`
        }
        （<a href={credit.workTitleEvidenceUrl} rel="noopener noreferrer"
          >標題狀態依據</a
        >）
      </dd>
    </div>
    <div data-credit-field="license">
      <dt>{credit.license.isPublicDomain ? "公有領域狀態" : "原作授權"}</dt>
      <dd>
        <a href={credit.license.url} rel="noopener noreferrer">
          {
            credit.license.isPublicDomain
              ? credit.license.token
              : credit.license.name
          }
        </a>
        {credit.license.isPublicDomain && <span>{credit.license.name}</span>}
        <span>；類別：{credit.bucketLabel}</span>
      </dd>
    </div>
    <div data-credit-field="source">
      <dt>固定來源</dt>
      <dd>
        <a href={selection.sourceRevision.permalink} rel="noopener noreferrer">
          Wikimedia Commons 永久說明頁（revision {selection.sourceRevision.id}）
        </a>
      </dd>
    </div>
    <div data-credit-field="alteration">
      <dt>變更說明</dt>
      <dd>{rightsAttribution.alterationState.disclosure}</dd>
    </div>
    {
      credit.uploaderText !== null && (
        <div data-credit-field="uploader">
          <dt>上傳者溯源</dt>
          <dd>{credit.uploaderText}</dd>
        </div>
      )
    }
    {
      noticeFields.map(({ field, label, notice }) => (
        <div data-credit-field={field} data-notice-status={notice.status}>
          <dt>{label}</dt>
          <dd>
            {notice.status === "supplied" ? (
              notice.sourceUrl === null ? (
                notice.text
              ) : (
                <a href={notice.sourceUrl} rel="noopener noreferrer">
                  {notice.text}
                </a>
              )
            ) : (
              "目前來源未另行提供"
            )}
          </dd>
        </div>
      ))
    }
    {
      rightsAttribution.licenseBucket === "cc-by-sa" && (
        <div data-credit-field="adapter-license">
          <dt>本站裁切改作貢獻之 Adapter&apos;s License</dt>
          <dd>
            <a
              href={rightsAttribution.adapterLicense!.url}
              rel="noopener noreferrer"
            >
              {rightsAttribution.adapterLicense!.name}
            </a>
            <span>（只及於本站裁切改作貢獻，不及於頁面其他內容）</span>
          </dd>
        </div>
      )
    }
    <div
      data-credit-field="occasion-risk"
      data-source-risk-category={credit.sourceRiskCategory ?? undefined}
      data-policy-version={credit.policyVersion}
    >
      <dt>來源事件與權利邊界</dt>
      <dd>
        <span>{selection.nonEventCaption}。</span>
        {
          credit.injuryRelationshipEvidence.map((evidence) => (
            <span>事件區分依據：{evidence}</span>
          ))
        }
        <span>
          {credit.nonClearanceStatement}
          此紀錄不代表著作權、肖像權或公開使用已獲放行。
        </span>
      </dd>
    </div>
  </dl>
  <a class="back-link" href="#photo-credits-heading">回到照片授權列表</a>
</article>

<style>
  .photo-credit {
    scroll-margin-block-start: 8rem;
    padding-block: 1.25rem;
    border-block-start: 1px solid var(--hairline);
  }

  .photo-credit:target {
    border-radius: 0.4rem;
    outline: 3px solid var(--color-brand-primary-hover);
    outline-offset: 0.35rem;
  }

  h2 {
    margin-block: 0 0.75rem;
  }

  dl {
    display: grid;
    gap: 0.65rem;
    margin: 0;
  }

  dl > div {
    display: grid;
    grid-template-columns: minmax(8rem, 0.28fr) minmax(0, 1fr);
    gap: 0.25rem 1rem;
  }

  dt {
    font-weight: 600;
  }

  dd {
    min-width: 0;
    margin: 0;
    overflow-wrap: anywhere;
  }

  dd span {
    display: block;
  }

  a {
    text-underline-offset: 0.15em;
  }

  .back-link {
    display: inline-block;
    margin-block-start: 0.9rem;
    font-size: var(--text-meta);
  }

  @media (max-width: 34rem) {
    dl > div {
      grid-template-columns: 1fr;
    }
  }
</style>
