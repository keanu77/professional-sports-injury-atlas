---
/**
 * Central external-source renderer. Decision 11 P2-5 keeps NBA evidence URLs
 * visible for auditability while never emitting a navigable NBA.com target.
 */
import { externalUrlPresentationFor } from "../../lib/rights/nba-link-policy";

interface Props {
  context: "follow-up" | "source-list" | "video";
  sourceId?: string;
  title: string;
  publisher: string;
  publishedAt: string;
  url: string;
  type?: string;
}

const { context, sourceId, title, publisher, publishedAt, url, type } =
  Astro.props;
const presentation = externalUrlPresentationFor(url);
const sourceLabels: Record<string, string> = {
  "video-original": "原始影片",
  "diagnosis-first-party": "官方診斷說明",
  "event-context": "事件報導",
  "teaching-evidence": "衛教參考",
};
const typeLabel =
  process.env.ATLAS_BUILD_MODE === "public" && type
    ? (sourceLabels[type] ?? "參考來源")
    : type;
---

{
  presentation !== "clickable-link" ? (
    <span
      class="external-source-citation"
      data-source-citation
      data-citation-context={context}
      data-citation-source-id={sourceId}
      data-link-policy={presentation}
    >
      <span data-citation-title>{title}</span>｜
      <span data-citation-publisher>{publisher}</span>｜
      <time datetime={publishedAt} data-citation-date>
        {publishedAt}
      </time>
      ｜URL：
      <span class="citation-url" data-citation-url>
        {url}
      </span>
      {type !== undefined && <>（{typeLabel}）</>}
    </span>
  ) : (
    <span
      class="external-source-citation"
      data-source-citation
      data-citation-context={context}
      data-citation-source-id={sourceId}
      data-link-policy={presentation}
    >
      <a href={url} rel="noopener noreferrer" data-citation-title>
        {title}
      </a>
      ｜<span data-citation-publisher>{publisher}</span>｜
      <time datetime={publishedAt} data-citation-date>
        {publishedAt}
      </time>
      {type !== undefined && <>（{typeLabel}）</>}
    </span>
  )
}

<style>
  .citation-url {
    overflow-wrap: anywhere;
  }
</style>
