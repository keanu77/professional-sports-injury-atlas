---
/**
 * Transparent empty state. Optional injury context adds only a governed local
 * editorial image; it never substitutes fabricated content.
 */
import { Picture } from "astro:assets";
import { findInjury } from "../../lib/contracts/taxonomy";
import { overviewImageFor } from "../../lib/ui/editorial-images";

interface Props {
  title: string;
  description?: string;
  injuryCode?: string;
  injuryLabel?: string;
}

const { title, description, injuryCode, injuryLabel } = Astro.props;
const photo = injuryCode === undefined ? null : overviewImageFor(injuryCode);
const photoLabel =
  injuryCode === undefined
    ? ""
    : (injuryLabel ?? findInjury(injuryCode)?.labelZh ?? injuryCode);
---

<div class="empty-state" data-empty-state data-injury-theme={injuryCode}>
  {
    photo !== null && (
      <div class="empty-state-media">
        <Picture
          src={photo}
          formats={["avif"]}
          fallbackFormat="webp"
          widths={[360, 640, 960]}
          sizes="(min-width: 48rem) 28rem, 90vw"
          loading="lazy"
          decoding="async"
          alt={`${photoLabel}原創 AI 生成攝影意象，非球員實際影像。`}
        />
      </div>
    )
  }
  <p class="empty-state-title">{title}</p>
  {description !== undefined && <p class="empty-state-body">{description}</p>}
</div>

<style>
  .empty-state {
    padding: 1rem;
    border: 1px dashed var(--hairline-strong);
    background: var(--color-surface-muted);
    text-align: center;
  }

  .empty-state-media {
    overflow: hidden;
    max-width: 28rem;
    margin: 0 auto 1rem;
    aspect-ratio: 16 / 9;
    opacity: 0.4;
  }

  .empty-state-media :global(picture),
  .empty-state-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .empty-state-media :global(img) {
    object-fit: cover;
  }

  .empty-state-title {
    margin: 0;
    font-weight: 600;
  }

  .empty-state-body {
    margin: 0.5rem auto 0;
  }
</style>
