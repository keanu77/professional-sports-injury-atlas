---
import VideoThumbnail from "../cases/VideoThumbnail.astro";
import type { ObservationClip } from "../../lib/videos/expansion";
import {
  observationCardMetadata,
  observationFootageLabel,
} from "../../lib/videos/observation-card";
import VideoTypeTags from "./VideoTypeTags.astro";
interface Props {
  clip: ObservationClip;
}
const { clip } = Astro.props;
const metadata = observationCardMetadata(clip);
const isMlb = clip.provider === "mlb";
---

<article class="observation-card" data-observation-card={clip.slug}>
  <a
    class="observation-card-media"
    href={`/videos/${clip.slug}/`}
    tabindex="-1"
    aria-hidden="true"
  >
    {
      isMlb ? (
        <div class="provider-facade" data-observation-provider="mlb">
          <span>MLB 官方影片</span>
          <strong>前往案例頁後，可選擇載入播放器</strong>
        </div>
      ) : (
        <VideoThumbnail videoId={clip.videoId}>
          <span slot="media-action" class="play" aria-hidden="true">
            ▶
          </span>
        </VideoThumbnail>
      )
    }
  </a>
  <div class="observation-copy">
    <p>{clip.event}</p><h3>
      <a
        href={`/videos/${clip.slug}/`}
        aria-label={`${clip.name}｜${clip.event}`}>{clip.name}</a
      >
    </h3>
    <ul class="observation-metadata" data-observation-metadata>
      <li data-observation-sport>{metadata.sport}</li>
      <li data-observation-body-part>{metadata.bodyPart}</li>
      <li data-observation-event-year>{metadata.eventYear}</li>
    </ul>
    <VideoTypeTags slug={clip.slug} videoUrl={clip.videoUrl} />
    <span data-observation-footage-kind={clip.footageKind ?? "unknown"}>
      {observationFootageLabel(clip)} →
    </span>
  </div>
</article>
<style>
  .observation-card {
    display: block;
    height: 100%;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--color-surface-raised);
    color: var(--color-ink);
  }
  .observation-card:hover {
    border-color: var(--color-brand-primary);
  }
  .observation-card-media {
    display: block;
    color: inherit;
  }
  .play {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--color-brand-accent);
    color: var(--color-brand-900);
  }
  .provider-facade {
    display: grid;
    align-content: center;
    min-height: 11rem;
    padding: 1.5rem;
    background: var(--color-brand-50);
    color: var(--color-ink);
  }
  .provider-facade span {
    color: var(--color-ink);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .provider-facade strong {
    margin-top: 0.5rem;
    font: 700 1.1rem/1.4 var(--font-display);
  }
  .observation-copy {
    padding: 1.2rem;
  }
  .observation-copy h3 {
    font: 700 1.2rem/1.5 var(--font-display);
    margin: 0.4rem 0 0.75rem;
  }
  .observation-copy h3 a {
    color: var(--color-ink);
    text-decoration: none;
  }
  .observation-copy h3 a:hover {
    color: var(--color-brand-primary);
  }
  .observation-copy h3 a:focus-visible {
    outline: 3px solid var(--color-brand-primary);
    outline-offset: 3px;
  }
  .observation-metadata {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.75rem;
    padding: 0;
    margin: 0 0 0.75rem;
    color: var(--color-ink-muted);
    font-size: 0.8rem;
    list-style: none;
  }
  .observation-metadata li + li::before {
    content: "·";
    margin-inline-end: 0.75rem;
  }
  .observation-copy p,
  .observation-copy > span {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: 0.8rem;
  }
</style>
