---
import VideoThumbnail from "../cases/VideoThumbnail.astro";
import type { ObservationClip } from "../../lib/videos/expansion";
interface Props {
  clip: ObservationClip;
}
const { clip } = Astro.props;
---

<a class="observation-card" href={`/videos/${clip.slug}/`}>
  <VideoThumbnail videoId={clip.videoId}>
    <span slot="media-action" class="play" aria-hidden="true">▶</span>
  </VideoThumbnail>
  <div class="observation-copy">
    <p>{clip.event}</p><h3>{clip.name}</h3><span>受傷動作觀察 →</span>
  </div>
</a>
<style>
  .observation-card {
    display: block;
    height: 100%;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--color-surface-raised);
    color: var(--color-ink);
    text-decoration: none;
  }
  .observation-card:hover {
    border-color: var(--color-brand-primary);
  }
  .play {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--color-brand-accent);
    color: var(--color-brand-900);
  }
  .observation-copy {
    padding: 1.2rem;
  }
  .observation-copy h3 {
    font: 700 1.2rem/1.5 var(--font-display);
    margin: 0.4rem 0 0.75rem;
  }
  .observation-copy p,
  .observation-copy > span {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: 0.8rem;
  }
</style>
