---
/**
 * Home-page feature card. Counts still come only from the permitted selector
 * output; the local case-cover crop is editorial context, never evidence.
 */
import { Picture } from "astro:assets";
import { featureImageFor } from "../../lib/ui/editorial-images";

interface Props {
  injuryCode: string;
  labelZh: string;
  reviewedCaseCount: number;
}

const { injuryCode, labelZh, reviewedCaseCount } = Astro.props;
const photo = featureImageFor(injuryCode);
---

<article
  class="injury-card"
  data-injury-card={injuryCode}
  data-injury-theme={injuryCode}
>
  <div class="injury-card-media">
    <Picture
      src={photo}
      formats={["avif"]}
      fallbackFormat="webp"
      widths={[360, 640, 960]}
      sizes="(min-width: 64rem) 22rem, (min-width: 48rem) 30vw, calc(100vw - 2rem)"
      loading="lazy"
      decoding="async"
      alt={`${labelZh}原創 AI 生成攝影意象，非球員實際影像。`}
    />
  </div>
  <div class="injury-card-body">
    <p class="injury-card-eyebrow eyebrow"><span>傷種圖鑑</span></p>
    <h3 class="injury-card-title">
      <a href={`/injuries/${injuryCode}/`}>{labelZh}</a>
    </h3>
    <p class="injury-card-count" data-reviewed-case-count={reviewedCaseCount}>
      已審查案例：<span class="injury-card-stat">{reviewedCaseCount}</span> 筆<span
        class="meta-en">（{reviewedCaseCount} reviewed cases）</span
      >
    </p>
  </div>
</article>

<style>
  .injury-card {
    position: relative;
    overflow: hidden;
    padding: 0;
    border: 1px solid var(--hairline);
    background: var(--color-surface-raised);
  }

  .injury-card-media {
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--color-surface-muted);
  }

  .injury-card-media :global(picture),
  .injury-card-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .injury-card-media :global(img) {
    object-fit: cover;
  }

  .injury-card-body {
    padding: 0.875rem 1rem 1rem;
  }

  .injury-card-eyebrow {
    display: flex;
    align-items: center;
    margin: 0 0 0.625rem;
  }

  .injury-card-eyebrow span {
    flex: 0 0 auto;
    padding-right: 0.375rem;
    background: var(--color-surface-raised);
  }

  .injury-card-eyebrow::after {
    width: 100%;
    height: 2px;
    background: var(--injury-color);
    content: "";
  }

  .injury-card-title {
    margin: 0 0 0.75rem;
    font-size: 1.5rem;
  }

  .injury-card-title a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .injury-card-title a::after {
    position: absolute;
    z-index: 2;
    inset: 0;
    content: "";
  }

  .injury-card-title a:hover {
    color: var(--color-brand-primary);
    transition: color 0.15s ease-in-out;
  }

  .injury-card-title a:focus-visible {
    outline: none;
  }

  .injury-card-title a:focus-visible::after {
    outline: 3px solid var(--color-brand-primary-hover);
    outline-offset: -3px;
  }

  .injury-card-count {
    display: flex;
    align-items: flex-end;
    margin: 0;
    color: var(--color-ink-muted);
    font: 400 var(--text-meta) / 1.5 var(--font-meta);
    flex-wrap: wrap;
    gap: 0 0.2em;
  }

  .injury-card-stat {
    display: inline-flex;
    flex-direction: column;
    color: var(--color-ink);
    font: 600 2.25rem/1 var(--font-display);
  }

  .injury-card-stat::after {
    width: 3rem;
    height: 2px;
    margin-top: 0.25rem;
    background: var(--color-metric);
    content: "";
  }

  .meta-en {
    font-size: 0.75rem;
    opacity: 1;
  }
</style>
