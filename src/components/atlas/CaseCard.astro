---
/**
 * Editorial case teaser. All factual text and governance selectors remain
 * unchanged; only the presentation order and visual hierarchy change.
 */
import { hasPublicEmbed } from "../../lib/patient/featured";
import CaseCover from "../cases/CaseCover.astro";
import ReviewBadge from "../cases/ReviewBadge.astro";
import { findInjury, findLeague } from "../../lib/contracts/taxonomy";
import type { InjuryCase } from "../../lib/contracts/case";
import {
  CLASSIC_CASE_LABEL,
  confirmationStatusLabel,
} from "../../lib/routes/static-paths";

interface Props {
  record: InjuryCase;
  showWorkflowBadge: boolean;
  compact?: boolean;
  priority?: boolean;
}

const {
  record,
  showWorkflowBadge,
  compact = false,
  priority = false,
} = Astro.props;
const injuryLabel =
  findInjury(record.injury.code)?.labelZh ?? record.injury.code;
const leagueLabel =
  findLeague(record.league.code)?.labelZh ?? record.league.code;
---

<article
  class:list={["case-card", { "case-card--compact": compact }]}
  data-case-card={record.id}
  data-injury-theme={record.injury.code}
>
  <CaseCover
    priority={priority}
    athleteName={record.athlete.name}
    injuryCode={record.injury.code}
    injuryLabel={injuryLabel}
    idPrefix={`case-card-cover-${record.id}`}
    recordId={record.id}
    presentation="thumb"
  >
    <a
      slot="media-action"
      class="case-card-media-link"
      href={`/cases/${record.slug}/`}
      aria-label={`查看${record.athlete.name}的${injuryLabel}案例`}
      >{
        hasPublicEmbed(record) && (
          <span class="card-play" aria-hidden="true">
            ▶
          </span>
        )
      }</a
    >
  </CaseCover>
  <div class="case-card-body">
    <p class="case-card-eyebrow eyebrow"><span>{injuryLabel}</span></p>
    <h3 class="case-card-title">
      <a href={`/cases/${record.slug}/`}>
        {record.athlete.name}｜{injuryLabel}
      </a>
    </h3>
    <p class="case-card-facts meta-row">
      {leagueLabel}｜{record.season} 球季｜{record.eventDate}｜
      {record.teamAtEvent.name} 對 {record.opponent.name}
    </p>
    {
      !compact && (
        <p
          class="case-card-confirmation meta-row"
          data-confirmation-status={record.injury.confirmationStatus}
        >
          診斷確認狀態（外部來源）：
          {confirmationStatusLabel(record.injury.confirmationStatus)}
        </p>
      )
    }
    {
      !compact && record.isClassic && (
        <p class="case-card-classic" data-classic-label>
          <strong>{CLASSIC_CASE_LABEL}</strong>
          {record.classicReason !== null && <>：{record.classicReason}</>}
        </p>
      )
    }
    {
      compact && (
        <p class="watch-label">
          觀看影片與回場重點 <span aria-hidden="true">↗</span>
        </p>
      )
    }
    {showWorkflowBadge && <ReviewBadge record={record} />}
  </div>
</article>

<style>
  .watch-label {
    color: var(--color-brand-primary);
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 0;
  }
  .case-card--compact .case-card-facts {
    font-size: 0.8rem;
  }
  .case-card {
    position: relative;
    overflow: hidden;
    padding: 0;
    border: 1px solid var(--color-brand-100);
    border-radius: var(--radius-card);
    background: var(--color-surface-raised);
    height: 100%;
    transition:
      box-shadow 160ms ease,
      border-color 160ms ease;
  }

  .case-card-body {
    padding: 1.25rem;
  }

  .case-card-eyebrow {
    display: flex;
    align-items: center;
    margin: 0 0 0.625rem;
  }

  .case-card-eyebrow span {
    flex: 0 0 auto;
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    color: var(--color-brand-primary);
    background: var(--color-brand-50);
  }

  .case-card-title {
    display: -webkit-box;
    overflow: hidden;
    margin: 0 0 0.5rem;
    font-size: var(--text-card-title);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .case-card-title a {
    color: var(--color-brand-900);
    text-decoration: none;
  }

  .case-card-media-link {
    position: absolute;
    z-index: 1;
    inset: 0;
  }

  .case-card-title a:hover {
    color: var(--color-brand-primary);
    transition: color 0.15s ease-in-out;
  }

  .case-card-title a:focus-visible {
    border-radius: 2px;
    outline: 3px solid var(--color-brand-primary-hover);
    outline-offset: 3px;
  }

  .case-card-media-link:focus-visible {
    outline: 3px solid var(--color-brand-primary-hover);
    outline-offset: -3px;
  }

  .case-card-facts {
    margin: 0 0 0.625rem;
  }

  .case-card-confirmation {
    display: inline-block;
    margin: 0 0 0.625rem;
    padding: 2px 10px;
    border: 1px solid var(--hairline);
    border-radius: 2px;
  }

  .case-card-confirmation[data-confirmation-status="confirmed"] {
    border-inline-start: 3px solid var(--color-brand-primary);
  }

  .case-card-classic {
    margin: 0 0 0.625rem;
    padding-inline-start: 0.625rem;
    border-inline-start: 3px solid var(--color-metric);
    color: var(--color-ink-muted);
    font: 400 var(--text-meta) / 1.5 var(--font-meta);
  }
  .case-card:hover {
    border-color: var(--color-brand-200);
    box-shadow: 0 12px 30px var(--shadow-stuck);
  }
  .card-play {
    position: absolute;
    inset-inline-end: 1rem;
    inset-block-end: 1rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--color-brand-accent);
    color: var(--color-on-warm);
    font-size: 1rem;
    box-shadow: 0 2px 8px var(--shadow-stuck);
  }
  .case-card :global(.case-cover-attribution) {
    padding: 0.6rem 1.25rem 0;
    font-size: 0.72rem;
    line-height: 1.6;
  }
</style>
