---
/**
 * Progressive filter block for listing pages. The static listing and its
 * pagination remain the complete no-JavaScript experience; this form is a
 * documented JavaScript enhancement that loads the case-index manifest and
 * needed 100-entry shards only after the first filter interaction. The two
 * status controls carry distinct labels: external diagnosis confirmation is
 * never the private review workflow and vice versa.
 */
import { INJURIES } from "../../data/taxonomy/injuries";
import { LEAGUES } from "../../data/taxonomy/leagues";
import { MECHANISMS } from "../../data/taxonomy/mechanisms";
import { SPORTS } from "../../data/taxonomy/sports";
import { CASE_STATUSES, CONFIRMATION_STATUSES } from "../../lib/contracts/case";
import { confirmationStatusLabel } from "../../lib/routes/static-paths";
import type { BuildMode } from "../../lib/governance/build-mode";

interface Props {
  buildMode: BuildMode;
  /** Preset injury scope for injury listing pages; null on league pages. */
  scopeInjury: string | null;
}

const { buildMode, scopeInjury } = Astro.props;

const WORKFLOW_LABELS: Record<string, string> = {
  draft: "草稿",
  "source-verified": "來源已驗證",
  "medical-review": "醫療審查中",
  approved: "已核准",
  rejected: "已退回",
  retired: "已下架",
};
---

<section
  class="case-filters"
  data-case-filters
  data-filter-scope={scopeInjury ?? undefined}
  aria-labelledby="case-filters-heading"
>
  <div class="case-filter-controls">
    <h2 class="section-title" id="case-filters-heading">篩選案例</h2>
    <noscript>
      <p class="filters-noscript">
        進階複合篩選需要 JavaScript；這是本站已記載的降級行為。沒有 JavaScript
        時，下方靜態列表與分頁仍完整可讀。
      </p>
    </noscript>
    <form data-filter-form>
      <div class="filter-grid">
        <label>
          球員或球隊關鍵字
          <input type="search" name="keyword" autocomplete="off" />
        </label>
        <label>
          事件年份
          <input type="number" name="eventYear" min="1900" max="2999" />
        </label>
        <label>
          球季
          <input type="text" name="season" autocomplete="off" />
        </label>
        <label>
          運動
          <select name="sport">
            <option value="">全部運動</option>
            {
              SPORTS.map((sport) => (
                <option value={sport.code}>{sport.labelZh}</option>
              ))
            }
          </select>
        </label>
        <label>
          聯盟
          <select name="league">
            <option value="">全部聯盟</option>
            {
              LEAGUES.map((league) => (
                <option value={league.code}>{league.labelZh}</option>
              ))
            }
          </select>
        </label>
        <label>
          傷種
          <select name="injury">
            <option value="">全部傷種</option>
            {
              INJURIES.map((injury) => (
                <option
                  value={injury.code}
                  selected={injury.code === scopeInjury}
                >
                  {injury.labelZh}
                </option>
              ))
            }
          </select>
        </label>
        <label>
          可見機轉標籤（觀察分類，非診斷）
          <select name="mechanism">
            <option value="">全部機轉標籤</option>
            {
              MECHANISMS.map((mechanism) => (
                <option value={mechanism.code}>{mechanism.labelZh}</option>
              ))
            }
          </select>
        </label>
        <label>
          診斷確認狀態（外部來源）
          <select name="confirmationStatus">
            <option value="">全部診斷確認狀態</option>
            {
              CONFIRMATION_STATUSES.map((status) => (
                <option value={status}>
                  {confirmationStatusLabel(status)}
                </option>
              ))
            }
          </select>
        </label>
        {
          buildMode === "review" && (
            <label>
              內部審查工作流程狀態（非診斷）
              <select name="workflowStatus">
                <option value="">全部工作流程狀態</option>
                {CASE_STATUSES.map((status) => (
                  <option value={status}>{WORKFLOW_LABELS[status]}</option>
                ))}
              </select>
            </label>
          )
        }
        <label class="filter-classic">
          <input type="checkbox" name="classicOnly" value="1" />
          只看經典案例
        </label>
      </div>
      <button type="button" class="filter-reset-button" data-filter-reset>
        重設全部篩選
      </button>
    </form>
  </div>
  <p class="filter-status" data-filter-status role="status" aria-live="polite">
  </p>
  <ol class="filter-results" data-filter-results hidden></ol>
</section>

<script>
  import { initCaseFilters } from "../../scripts/case-filters";

  initCaseFilters();
</script>

<style>
  .case-filters {
    scroll-margin-block-start: 6rem;
  }

  .case-filter-controls {
    padding: 1rem;
    border-block-end: 1px solid var(--hairline);
    background: var(--color-surface);
  }

  .case-filters h2 {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 var(--space-block);
    font-family: var(--font-heading);
    font-size: var(--text-h2);
  }

  .case-filters h2::after {
    height: 2px;
    flex: 1;
    background: linear-gradient(
      90deg,
      var(--injury-color, var(--color-brand-primary)) 0 2.5rem,
      var(--hairline) 2.5rem 100%
    );
    content: "";
  }

  .filters-noscript {
    color: var(--color-ink-muted);
    font: 400 var(--text-meta) / 1.5 var(--font-meta);
  }

  .filter-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
    gap: 1rem 0.75rem;
  }

  .filter-grid label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    color: var(--color-ink-muted);
    font: 400 var(--text-meta) / 1.5 var(--font-meta);
  }

  .filter-grid input,
  .filter-grid select {
    width: 100%;
    height: 44px;
    min-height: 44px;
    padding: 0.375rem 0.5rem;
    border: 1px solid var(--hairline);
    border-block-end: 2px solid transparent;
    border-radius: 0;
    background: var(--color-surface);
    color: var(--color-ink);
    font: inherit;
  }

  .filter-grid input:focus,
  .filter-grid input:checked,
  .filter-grid select:focus,
  .filter-grid select:has(option:checked:not([value=""])),
  .filter-grid input:-webkit-autofill {
    border-block-end-color: var(--injury-color, var(--color-brand-primary));
    font-weight: 600;
  }

  .filter-grid label:focus-within,
  .filter-grid label:has(input:checked),
  .filter-grid label:has(select option:checked:not([value=""])) {
    color: var(--color-ink);
    font-weight: 600;
  }

  .filter-classic {
    flex-direction: row !important;
    align-items: center;
    min-height: 44px;
  }

  .filter-classic input {
    min-height: auto;
    width: 1.25rem;
    height: 1.25rem;
    accent-color: var(--injury-color, var(--color-brand-primary));
  }

  .filter-reset-button {
    margin-top: 0.75rem;
    min-height: 44px;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-brand-primary);
    border-radius: 0;
    background: var(--color-brand-primary);
    box-shadow: none;
    color: var(--color-on-brand);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transform: none;
  }

  .filter-reset-button:hover,
  .filter-reset-button:active {
    background: var(--color-brand-primary-hover);
  }

  .filter-status {
    margin: 0.75rem 0 0;
    padding-inline: 1rem;
    color: var(--color-ink-muted);
    font: 400 var(--text-meta) / 1.5 var(--font-meta);
  }

  .filter-results {
    margin: 0.75rem 0 0;
    padding-inline: 2.25rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  @media (min-width: 64rem) {
    .case-filter-controls {
      position: sticky;
      z-index: 10;
      top: 4.75rem;
    }
  }
</style>
