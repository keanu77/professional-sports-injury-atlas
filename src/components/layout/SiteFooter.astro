 * claim of clearance beyond the recorded per-source review.
 */
import MedicalNotice from "../notices/MedicalNotice.astro";
---

<footer class="site-footer">
  <div class="site-footer-top">
    <div class="site-footer-inner footer-grid">
      <nav class="footer-column" aria-label="使用說明">
        <p class="footer-heading">使用說明</p>
        <ul>
          <li><a href="/source-policy/">影片來源與資料查核</a></li>
          <li><a href="/credits-notices/">影片與圖片使用說明</a></li>
          <li><a href="/privacy/">隱私與播放設定</a></li>
        </ul>
      </nav>
      <nav class="footer-column" aria-label="關於本站">
        <p class="footer-heading">關於本站</p>
        <ul>
          <li>
            <a href="https://sportsmedicine.tw/content/">返回吳易澄醫師網站</a>
          </li>
          <li><a href="/about/">認識影片圖鑑</a></li>
        </ul>
      </nav>
      <div class="footer-disclosure">
        <p>從真實運動影片，認識受傷當下的處理與選手回場歷程。</p>
