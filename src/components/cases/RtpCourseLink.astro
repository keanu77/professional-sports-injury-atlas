---
/**
 * Read-only RTP course mapping card. The public URL renders only when the
 * fail-closed durable-decision evaluation passes; in every other state the
 * card shows the exact `課程連結待核准` label and never guesses a URL.
 */
import { existsSync, readFileSync } from "node:fs";
import governance from "../../data/site-governance.v1.json";
import { courseLinkPresentation } from "../../lib/routes/static-paths";
import { courseLinkDecisionPathFor } from "../../lib/rtp/course-link-decision";
import type {
  ProfessionalCourseLink,
  RtpCourseSummary,
} from "../../lib/rtp/course-links";

interface Props {
  link: ProfessionalCourseLink;
  course: RtpCourseSummary;
}

const { link, course } = Astro.props;

const durablePath = courseLinkDecisionPathFor(link.key);
const decisionBytes = existsSync(durablePath)
  ? readFileSync(durablePath)
  : null;
const presentation = courseLinkPresentation({
  link,
  course,
  decisionBytes,
  decisionPath: decisionBytes === null ? null : durablePath,
  courseLinkPolicyVersion: governance.courseLinkPolicyVersion ?? "",
});
---

<article
  class="course-card"
  data-course-key={link.key}
  data-injury-theme={link.injuryCode}
>
  <h3 class="course-title">
    {
      presentation.state === "approved" && presentation.url !== null ? (
        <a href={presentation.url} rel="noopener noreferrer">
          {course.titleZh}
        </a>
      ) : (
        course.titleZh
      )
    }
  </h3>
  <p class="course-scope">適用範圍：{link.scopeNote}</p>
  <p class="course-subtitle">{course.subtitle}</p>
  {
    presentation.state === "approved" && presentation.url !== null ? (
      <p>
        <a href={presentation.url} rel="noopener noreferrer">
          前往課程（外部連結）
        </a>
      </p>
    ) : (
      <p class="course-pending" data-course-link-pending>
        {presentation.pendingLabel}
      </p>
    )
  }
</article>

<style>
  .course-card {
    position: relative;
    padding: 0.75rem 0 0.75rem 1rem;
    border-block-end: 1px solid var(--hairline);
    background: transparent;
  }

  .course-card::before {
    position: absolute;
    inset-block-start: 1.15rem;
    inset-inline-start: 0;
    width: 6px;
    height: 6px;
    background: var(--injury-color);
    content: "";
  }

  .course-title {
    display: -webkit-box;
    overflow: hidden;
    margin: 0 0 0.5rem;
    font-family: var(--font-heading);
    font-size: var(--text-card-title);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .course-title a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .course-title a:hover {
    color: var(--color-brand-primary);
    transition: color 0.15s ease-in-out;
  }

  .course-scope,
  .course-subtitle {
    margin: 0 0 0.5rem;
    color: var(--color-ink-muted);
    font: 400 var(--text-meta) / 1.5 var(--font-meta);
  }

  .course-card > p:last-child {
    margin-bottom: 0;
    font: 600 var(--text-meta) / 1.5 var(--font-meta);
  }

  .course-pending {
    margin: 0;
  }
</style>
