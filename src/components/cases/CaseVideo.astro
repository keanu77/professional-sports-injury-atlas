---
/**
 * Privacy-preserving case-video facade. Before activation it renders only the
 * case's local cover (YouTube default thumbnail for public videos) and metadata. Depending
 * on the source policy it exposes either a real source anchor or a literal
 * non-clickable citation: no remote thumbnail, game frame, iframe,
 * preconnect, or third-party request.
 * Verified YouTube videos gain an explicit load button; caption-degraded
 * YouTube videos use an external-link cover, while NBA-hosted sources use a
 * non-clickable citation cover. The five governed portrait videos receive a
 * centered 9:16 iframe after activation without changing the frozen case
 * contract.
 */
import { captionsOptionalFor } from "../../lib/videos/expansion";
import CaseCover from "./CaseCover.astro";
import ExternalSourceCitation from "../citations/ExternalSourceCitation.astro";
import {
  captionStatusLabel,
  formatDurationLabel,
  resolvePlayerPresentation,
  type VideoDisplayMode,
} from "../../lib/video/player-state";
import { resolveVideoOrientation } from "../../lib/video/facade";
import { videoRegionRestrictionFor } from "../../lib/video/availability";
import { parseYouTubeVideoId } from "../../lib/video/youtube";
import { externalUrlPresentationFor } from "../../lib/rights/nba-link-policy";
import type { CaptionStatus } from "../../lib/contracts/case";
import type { EmbedStatus } from "../../lib/contracts/taxonomy";

interface Props {
  athleteName?: string;
  compact?: boolean;
  scopeId: string;
  recordId?: string;
  displayMode: VideoDisplayMode;
  sourceTitle: string;
  sourceCitation: {
    title: string;
    publisher: string;
    publishedAt: string;
    url: string;
  };
  injuryCode: string;
  injuryLabel: string;
  video: {
    provider: string;
    canonicalUrl: string;
    uploaderName: string;
    durationSeconds: number;
    embedStatus: EmbedStatus;
    captionStatus: CaptionStatus;
  };
}

const {
  athleteName,
  compact = false,
  scopeId,
  recordId = scopeId,
  displayMode,
  sourceTitle,
  sourceCitation,
  injuryCode,
  injuryLabel,
  video,
} = Astro.props;

const presentation = resolvePlayerPresentation({
  providerCode: video.provider,
  canonicalUrl: video.canonicalUrl,
  embedStatus: video.embedStatus,
  captionStatus: video.captionStatus,
  displayMode,
  captionsOptional: captionsOptionalFor(video.canonicalUrl),
});
const regionRestriction = videoRegionRestrictionFor(
  video.provider,
  video.canonicalUrl,
);
const sourceUrlPresentation = externalUrlPresentationFor(video.canonicalUrl);
if (sourceCitation.url !== video.canonicalUrl) {
  throw new Error(
    `video source citation URL mismatch for ${scopeId}: ${sourceCitation.url}`,
  );
}
if (
  (presentation === "click-to-load" || regionRestriction !== null) &&
  sourceUrlPresentation !== "clickable-link"
) {
  throw new Error(
    `navigable video state is forbidden for governed plain-text citation ${video.canonicalUrl}`,
  );
}

let videoId: string | null = null;
if (presentation === "click-to-load") {
  videoId = parseYouTubeVideoId(video.canonicalUrl);
  if (videoId === null) {
    throw new Error(
      `click-to-load requires a canonical YouTube URL: ${video.canonicalUrl}`,
    );
  }
}

const orientation = resolveVideoOrientation(video.provider, video.canonicalUrl);
const captionLabel = captionStatusLabel(video.captionStatus);
const durationLabel = formatDurationLabel(video.durationSeconds);
const sourceAccessLabel =
  sourceUrlPresentation !== "clickable-link"
    ? "原始頁純文字引註"
    : "原始平台連結";
const captionWarning =
  video.captionStatus === "available" || captionsOptionalFor(video.canonicalUrl)
    ? null
    : displayMode === "public"
      ? `依無障礙政策，字幕未確認可用的影片不在本站內嵌播放，僅提供${sourceAccessLabel}與文字說明。`
      : `字幕尚未確認可用：公開版將降級為${sourceAccessLabel}，站內播放僅供審查。`;
const platformLabel =
  video.provider === "nba"
    ? "NBA.com"
    : video.provider === "youtube"
      ? "YouTube"
      : "原始平台";
const coverIdPrefix = `video-cover-${scopeId}`;
---

<section
  class="case-video"
  data-video-scope={presentation === "click-to-load" ? scopeId : undefined}
  data-video-embed={presentation === "click-to-load" ? "" : undefined}
  data-video-external={presentation === "external-link-only" ? "" : undefined}
  data-video-unavailable={presentation === "unavailable-notice"
    ? ""
    : undefined}
  data-video-region-blocked={regionRestriction?.audienceCountryCode}
  data-video-id={videoId ?? undefined}
  data-video-title={presentation === "click-to-load"
    ? `案例影片播放器：${sourceTitle}`
    : undefined}
  data-video-orientation={orientation}
  aria-label={`影片來源：${sourceTitle}`}
>
  {
    presentation === "click-to-load" && (
      <div
        class="case-video-stage"
        data-video-stage
        data-video-orientation={orientation}
      >
        <div class="video-facade" data-video-facade>
          <CaseCover
            athleteName={athleteName}
            injuryCode={injuryCode}
            injuryLabel={injuryLabel}
            idPrefix={coverIdPrefix}
            recordId={recordId}
            presentation="facade"
          >
            <button
              slot="media-action"
              type="button"
              class="video-load-button"
              data-video-load
              hidden
              aria-describedby={`video-status-${scopeId}`}
            >
              <span class="video-load-label">
                <span class="video-play-symbol" aria-hidden="true">
                  ▶
                </span>
                <span class="video-load-copy">
                  <strong>載入 YouTube 播放器</strong>
                  <small>點擊後才會連線至 YouTube</small>
                </span>
              </span>
            </button>
          </CaseCover>
        </div>
        <p class="case-video-failure" data-video-failure hidden>
          站內播放器載入失敗，請改用下方原始連結。
        </p>
      </div>
    )
  }

  {
    presentation === "external-link-only" &&
      regionRestriction === null &&
      sourceUrlPresentation === "clickable-link" && (
        <CaseCover
          athleteName={athleteName}
          injuryCode={injuryCode}
          injuryLabel={injuryLabel}
          idPrefix={coverIdPrefix}
          recordId={recordId}
          presentation="facade"
        >
          <a
            slot="media-action"
            class="video-external-facade"
            data-video-source-link
            href={video.canonicalUrl}
            rel="noopener noreferrer"
          >
            <span class="video-external-label">
              <strong>於 {platformLabel} 觀看</strong>
              <small>
                外部連結 <span aria-hidden="true">↗</span>
              </small>
            </span>
          </a>
        </CaseCover>
      )
  }

  {
    presentation === "external-link-only" &&
      regionRestriction === null &&
      sourceUrlPresentation !== "clickable-link" && (
        <CaseCover
          athleteName={athleteName}
          injuryCode={injuryCode}
          injuryLabel={injuryLabel}
          idPrefix={coverIdPrefix}
          recordId={recordId}
          presentation="facade"
        >
          <span
            slot="media-action"
            class="video-external-facade video-external-citation-facade"
            data-video-source-citation-facade
          >
            <span class="video-external-label">
              <strong>{platformLabel} 原始頁不設超連結</strong>
              <small>完整純文字引註見下方</small>
            </span>
          </span>
        </CaseCover>
      )
  }

  {
    presentation === "external-link-only" &&
      regionRestriction !== null &&
      sourceUrlPresentation === "clickable-link" && (
        <div class="video-region-restricted" data-video-region-fallback>
          <p>
            <strong>台灣地區站內播放器已停用</strong>
            <span>原始平台仍可能顯示地區限制。</span>
          </p>
          <a
            class="case-video-source-link"
            data-video-source-link
            href={video.canonicalUrl}
            rel="noopener noreferrer"
          >
            開啟 ESPN 原始頁（外部連結）
          </a>
        </div>
      )
  }

  {
    presentation === "unavailable-notice" && (
      <CaseCover
        athleteName={athleteName}
        injuryCode={injuryCode}
        injuryLabel={injuryLabel}
        idPrefix={coverIdPrefix}
        recordId={recordId}
        presentation="facade"
      />
    )
  }

  {
    presentation === "click-to-load" && (
      <p
        id={`video-status-${scopeId}`}
        class="sr-only"
        role="status"
        aria-live="polite"
        aria-atomic="true"
        data-video-status
      />
    )
  }

  <details class="case-video-meta" open={!compact}>
    <summary hidden={!compact}>影片來源與字幕</summary>
    <p class="case-video-title">{sourceTitle}</p>
    <p class="case-video-facts">
      上傳者：{video.uploaderName}｜長度：{durationLabel}
    </p>
    {
      sourceUrlPresentation !== "clickable-link" && (
        <p class="case-video-source-citation" data-video-source-citation>
          <ExternalSourceCitation context="video" {...sourceCitation} />
        </p>
      )
    }
    <p
      class="case-video-caption-status"
      data-caption-status={video.captionStatus}
    >
      {captionLabel}
    </p>
    {
      captionWarning !== null && (
        <p class="case-video-warning" data-caption-warning>
          {captionWarning}
        </p>
      )
    }
    {
      regionRestriction !== null && (
        <p class="case-video-warning" data-video-region-warning>
          此原始影片目前未對台灣提供播放；本站不載入播放器，僅保留 ESPN
          原始頁外部連結，原平台仍可能顯示地區限制。
        </p>
      )
    }
    {
      displayMode === "review" && (
        <p class="case-video-review-state" data-review-state>
          審查資訊：embedStatus={video.embedStatus}、captionStatus=
          {video.captionStatus}、presentation={presentation}
        </p>
      )
    }
  </details>
  {
    presentation === "click-to-load" &&
      sourceUrlPresentation === "clickable-link" && (
        <p class="case-video-source-action">
          <a
            class="case-video-source-link"
            data-video-source-link
            href={video.canonicalUrl}
            rel="noopener noreferrer"
          >
            於 YouTube 觀看原始影片（外部連結）
          </a>
        </p>
      )
  }
  {
    presentation === "unavailable-notice" && (
      <p class="case-video-notice" data-video-unavailable-notice>
        原始影片目前無法取得，本案例暫不提供影片播放。文字說明仍然完整可讀。
      </p>
    )
  }
</section>

<script>
  import { initCaseVideos } from "../../scripts/video-player";

  initCaseVideos();
</script>

<style>
  .case-video {
    margin: 0;
    padding: 1rem;
    border: 1px solid var(--hairline);
    background: var(--color-surface-raised);
  }

  .case-video-stage,
  .video-facade {
    position: relative;
  }

  .video-load-button {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 100%;
    min-height: 44px;
    padding: clamp(0.65rem, 3vw, 1.25rem);
    border: 0;
    background: transparent;
    color: var(--color-on-brand);
    font: inherit;
    cursor: pointer;
  }

  .video-load-button[hidden] {
    display: none;
  }

  .video-load-button:focus-visible {
    outline: 4px solid var(--color-brand-primary-hover);
    outline-offset: -4px;
  }

  .video-load-label {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 100%;
    padding: 0.65rem 0.9rem;
    border: 2px solid var(--color-on-brand);
    border-radius: 999px;
    background: var(--color-brand-primary);
    box-shadow: 0 0.5rem 1.5rem var(--shadow-overlay);
  }

  .video-load-button:hover .video-load-label {
    background: var(--color-brand-primary-hover);
    transition: background-color 0.15s ease-in-out;
  }

  .video-play-symbol {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding-inline-start: 0.12rem;
    border: 2px solid currentColor;
    border-radius: 50%;
  }

  .video-load-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.3;
    text-align: start;
  }

  .video-load-copy small {
    font-size: var(--text-eyebrow);
  }

  .video-external-facade {
    position: absolute;
    z-index: 1;
    inset: 0;
    display: flex;
    overflow: hidden;
    align-items: flex-end;
    color: var(--color-ink);
    text-decoration: none;
  }

  .video-external-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    min-height: 44px;
    padding: 0.7rem 1rem;
    background: var(--color-brand-primary);
    color: var(--color-on-brand);
  }

  .video-external-facade:hover .video-external-label {
    background: var(--color-brand-primary-hover);
  }

  .video-external-citation-facade {
    cursor: default;
  }

  .video-external-citation-facade:hover .video-external-label {
    background: var(--color-brand-primary);
  }

  .video-external-label small {
    white-space: nowrap;
  }

  .video-region-restricted {
    display: grid;
    gap: 0.75rem;
    padding: 1rem;
    border: 1px solid var(--color-warning-border);
    border-radius: 6px;
    background: var(--color-warning-surface);
  }

  .video-region-restricted p {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    color: var(--color-warning);
  }

  .video-region-restricted a {
    width: fit-content;
    min-height: 44px;
    padding: 0.65rem 0.9rem;
    border-radius: 6px;
    background: var(--color-brand-primary);
    color: var(--color-on-brand);
    font-weight: 700;
  }

  .case-video-meta {
    margin-top: 1rem;
  }

  .case-video-title {
    margin: 0 0 0.5rem;
    font-family: var(--font-heading);
    font-weight: 700;
  }

  .case-video-facts,
  .case-video-caption-status,
  .case-video-review-state,
  .case-video-source-action,
  .case-video-source-citation {
    margin: 0 0 0.5rem;
    color: var(--color-ink-muted);
    font: 400 var(--text-meta) / 1.5 var(--font-meta);
  }

  .case-video-warning {
    margin: 0 0 0.5rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-warning-border);
    border-radius: 6px;
    background: var(--color-warning-surface);
    color: var(--color-warning);
    font-weight: 600;
  }

  .case-video-failure,
  .case-video-notice {
    margin: 0.75rem 0 0;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-danger-border);
    border-radius: 6px;
    background: var(--color-danger-surface);
    color: var(--color-danger);
    font-weight: 600;
  }

  .case-video :global(.case-video-frame) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    background: var(--color-surface-muted);
  }

  .case-video[data-video-orientation="portrait"] :global(.case-video-frame) {
    max-width: 24rem;
    margin-inline: auto;
    aspect-ratio: 9 / 16;
  }

  @media (max-width: 28rem) {
    .video-load-label {
      gap: 0.5rem;
      padding: 0.5rem 0.7rem;
    }

    .video-play-symbol {
      width: 2rem;
      height: 2rem;
    }
  }
</style>
