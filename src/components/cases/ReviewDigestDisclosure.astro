---
/**
 * Native review-only disclosure for a case identity and its independent
 * approved-core, rendered-set, and pending follow-up digests. Every value is
 * server-rendered and selectable; no client script controls this disclosure.
 */
interface Props {
  scopeId: string;
  recordId: string;
  contentDigest: string;
  renderedSetDigest: string;
  followUpDigest?: string;
}

const { scopeId, recordId, contentDigest, renderedSetDigest, followUpDigest } =
  Astro.props;
const digestPattern = /^[0-9a-f]{64}$/u;
if (
  scopeId.trim() === "" ||
  recordId.trim() === "" ||
  !digestPattern.test(contentDigest) ||
  !digestPattern.test(renderedSetDigest) ||
  (followUpDigest !== undefined && !digestPattern.test(followUpDigest))
) {
  throw new Error(`invalid review digest disclosure for ${recordId}`);
}

const contentDigestId = `${scopeId}-case-content-digest`;
const renderedSetDigestId = `${scopeId}-rendered-set-digest`;
const followUpDigestId = `${scopeId}-follow-up-draft-digest`;
---

<details class="digest-disclosure case-section" data-review-digests>
  <summary class="digest-summary">審查識別與 digest</summary>
  <div class="digest-content" data-review-digest-content>
    <p>
      記錄 ID：<code data-record-id>{recordId}</code>
    </p>
    <label class="digest-label" for={contentDigestId}>
      案例內容 digest（可複製）
    </label>
    <input
      id={contentDigestId}
      class="digest-field"
      type="text"
      readonly
      value={contentDigest}
      data-review-digest-kind="case-content"
    />
    <label class="digest-label" for={renderedSetDigestId}>
      本次建置審查集合 digest（可複製）
    </label>
    <input
      id={renderedSetDigestId}
      class="digest-field"
      type="text"
      readonly
      value={renderedSetDigest}
      data-review-digest-kind="rendered-set"
    />
    {
      followUpDigest !== undefined && (
        <>
          <label class="digest-label" for={followUpDigestId}>
            後續消息草稿 digest（待醫師簽核，可複製）
          </label>
          <input
            id={followUpDigestId}
            class="digest-field"
            type="text"
            readonly
            value={followUpDigest}
            data-review-digest-kind="pending-follow-up"
            data-follow-up-draft-digest
            data-review-status="pending-owner-signoff"
          />
        </>
      )
    }
  </div>
</details>

<style>
  .digest-disclosure {
    margin-block-start: var(--space-section);
    border-block: 1px solid var(--hairline);
  }

  .digest-summary {
    display: list-item;
    min-height: 44px;
    padding-block: 0.5rem;
    cursor: pointer;
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 700;
    line-height: 1.3;
  }

  .digest-summary:focus-visible {
    outline: 3px solid var(--color-brand-primary-hover);
    outline-offset: 3px;
  }

  .digest-content {
    padding-block: 0.5rem 1rem;
  }

  .digest-label {
    display: block;
    margin-block: 0.75rem 0.25rem;
    font-weight: 600;
  }

  .digest-field {
    display: block;
    min-height: 44px;
    width: min(100%, 42rem);
    padding: 0.375rem 0.5rem;
    border: 1px solid var(--hairline-strong);
    border-radius: 0;
    background: var(--color-surface-raised);
    color: var(--color-ink);
    font-family: ui-monospace, monospace;
    font-size: 0.875rem;
  }
</style>
