---
/**
 * Governed local editorial-photo cover shared by case cards and video
 * facades. The photograph is an original AI-generated asset selected by a
 * stable record-id hash and delivered through Astro's responsive Picture
 * pipeline. Legacy data-cover-illustration markers remain as nonvisual data
 * hooks; no vector artwork is rendered.
 */
import { Picture } from "astro:assets";
import { caseImageFor } from "../../lib/ui/editorial-images";

interface Props {
  injuryCode: string;
  injuryLabel: string;
  idPrefix?: string;
  recordId?: string;
  presentation?: "standalone" | "facade" | "thumb";
}

const {
  injuryCode,
  injuryLabel,
  idPrefix = "case-cover",
  recordId = idPrefix,
  presentation = "standalone",
} = Astro.props;
const { image: photo, variant } = caseImageFor(injuryCode, recordId);
const renditionWidths =
  presentation === "thumb" ? [360, 560, 768, 960] : [480, 768, 960, 1536];
const photoSizes =
  presentation === "thumb"
    ? "(min-width: 64rem) 22rem, (min-width: 40rem) 42rem, calc(100vw - 2rem)"
    : "(min-width: 64rem) 43rem, calc(100vw - 4rem)";
const photoAlt = `${injuryLabel}原創 AI 生成運動醫學攝影意象；匿名運動員面孔不可見，不代表任何特定球員或真實受傷事件。`;
---

<figure
  class:list={["case-cover", `case-cover-${presentation}`]}
  data-case-cover={presentation === "thumb" ? undefined : injuryCode}
  data-case-thumb={presentation === "thumb" ? injuryCode : undefined}
  data-cover-presentation={presentation}
  data-cover-variant={String(variant)}
  data-injury-theme={injuryCode}
>
  <div class="case-cover-media">
    <Picture
      src={photo}
      formats={["avif", "webp"]}
      fallbackFormat="png"
      widths={renditionWidths}
      sizes={photoSizes}
      quality={72}
      loading="lazy"
      decoding="async"
      alt={photoAlt}
      class="case-cover-photo"
      pictureAttributes={{ class: "case-cover-picture" }}
    />
    <span data-cover-illustration={injuryCode} aria-hidden="true"></span>
  </div>
  {
    presentation === "standalone" && (
      <figcaption>原創 AI 生成攝影意象，非球員實際影像。</figcaption>
    )
  }
</figure>

<style>
  .case-cover {
    --cover-aspect-ratio: 5 / 2;
    margin: 0 0 1.5rem;
  }

  .case-cover-thumb {
    --cover-aspect-ratio: 16 / 9;
    margin: 0;
  }

  .case-cover-facade {
    margin: 0;
  }

  .case-cover-media {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--cover-aspect-ratio);
    background-color: var(--color-surface-muted);
  }

  .case-cover-media :global(picture),
  .case-cover-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .case-cover-media :global(img) {
    object-fit: cover;
  }

  [data-cover-illustration] {
    display: none;
  }

  .case-cover figcaption {
    margin-top: 0.45rem;
    color: var(--color-ink-muted);
    font: 400 var(--text-meta) / 1.5 var(--font-meta);
  }
</style>
