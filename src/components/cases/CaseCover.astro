---
/**
 * Governed case cover shared by heroes, cards, and privacy-preserving video
 * facades. Registered cases use a local, hash-bound Commons JPEG with visible
 * attribution; unknown fixture IDs retain the injury-theme fallback.
 */
import { Picture } from "astro:assets";
import {
  caseImageFor,
  type CaseImageSelection,
} from "../../lib/ui/editorial-images";
import {
  CASE_COVER_QUALITY,
  CASE_HERO_QUALITY,
  caseHeroWidthsFor,
  caseThumbWidthsFor,
} from "../../lib/ui/image-renditions";

interface Props {
  athleteName?: string;
  imageAlt?: string;
  injuryCode: string;
  injuryLabel: string;
  idPrefix?: string;
  recordId?: string;
  presentation?: "hero" | "standalone" | "facade" | "thumb";
  selection?: CaseImageSelection;
}

const {
  athleteName,
  imageAlt,
  injuryCode,
  injuryLabel,
  idPrefix = "case-cover",
  recordId = idPrefix,
  presentation = "standalone",
  selection: suppliedSelection,
} = Astro.props;
const selection =
  suppliedSelection ?? caseImageFor(injuryCode, recordId, athleteName);
if (
  selection.kind === "licensed-player-photo" &&
  selection.athleteName !== athleteName
) {
  throw new Error(
    `Case cover athlete mismatch for ${recordId}: expected ${selection.athleteName}, received ${athleteName ?? "missing athlete"}`,
  );
}

const isHero = presentation === "hero";
const isThumb = presentation === "thumb";
const renditionWidths = isThumb
  ? caseThumbWidthsFor(selection.image.width)
  : caseHeroWidthsFor(selection.image.width);
const photoSizes = isHero
  ? "(min-width: 48rem) 48rem, calc(100vw - 2rem)"
  : isThumb
    ? "(min-width: 64rem) 22rem, (min-width: 40rem) 42rem, calc(100vw - 2rem)"
    : "(min-width: 64rem) 43rem, calc(100vw - 4rem)";
const photoAlt =
  selection.kind === "licensed-player-photo"
    ? `${selection.athleteName}球員球場資料照片；非本案例受傷當下影像。`
    : (imageAlt ??
      `${injuryLabel}原創 AI 生成運動醫學攝影意象；匿名運動員面孔不可見，不代表任何特定球員或真實受傷事件。`);
const showFallbackCaption = isHero || presentation === "standalone";
let sourceRiskLabel: string | null = null;
if (selection.kind === "licensed-player-photo") {
  const category = selection.attribution.sourceRiskClassification.category;
  switch (category) {
    case "game-action-high-risk":
      sourceRiskLabel =
        "賽場實拍（game-action-high-risk；Flickr-washing 高風險）";
      break;
    case "non-event-low-risk":
      sourceRiskLabel = "非賽事場合（non-event-low-risk；低風險分類）";
      break;
    default:
      throw new Error(
        `Unsupported player-photo source-risk category for ${recordId}: ${String(category)}`,
      );
  }
}
---

<figure
  class:list={[
    "case-cover",
    `case-cover-${presentation}`,
    { "editorial-case-figure": isHero },
  ]}
  data-case-cover={isThumb ? undefined : injuryCode}
  data-case-thumb={isThumb ? injuryCode : undefined}
  data-cover-kind={selection.kind}
  data-cover-presentation={presentation}
  data-cover-variant={selection.variant === null
    ? undefined
    : String(selection.variant)}
  data-editorial-case-cover={isHero ? recordId : undefined}
  data-injury-theme={injuryCode}
  data-player-photo={selection.kind === "licensed-player-photo"
    ? selection.athleteName
    : undefined}
  data-focal-x={String(selection.focalPosition.xPercent)}
  data-focal-y={String(selection.focalPosition.yPercent)}
  style={`--cover-focal-x: ${selection.focalPosition.xPercent}%; --cover-focal-y: ${selection.focalPosition.yPercent}%;`}
>
  <div class="case-cover-media">
    <Picture
      src={selection.image}
      formats={["avif", "webp"]}
      fallbackFormat={selection.kind === "licensed-player-photo"
        ? "jpg"
        : "png"}
      widths={renditionWidths}
      width={renditionWidths.at(-1)!}
      sizes={photoSizes}
      quality={isHero ? CASE_HERO_QUALITY : CASE_COVER_QUALITY}
      loading={isHero ? "eager" : "lazy"}
      decoding="async"
      fetchpriority={isHero ? "high" : undefined}
      alt={photoAlt}
      class="case-cover-photo"
      pictureAttributes={{ class: "case-cover-picture" }}
    />
    <slot name="media-action" />
    <span data-cover-illustration={injuryCode} aria-hidden="true"></span>
  </div>
  {
    selection.kind === "licensed-player-photo" ? (
      <figcaption
        class="case-cover-attribution"
        data-license-bucket={
          selection.attribution.rightsAttribution.licenseBucket
        }
        data-source-revision-id={String(
          selection.attribution.rightsAttribution.sourceRevision.id,
        )}
        data-source-risk-category={
          selection.attribution.sourceRiskClassification.category
        }
      >
        {selection.attribution.rightsAttribution.licenseBucket === "cc-by" ? (
          <>
            {selection.attribution.rightsAttribution.workTitle.status ===
            "supplied" ? (
              <>
                <span>
                  作品：〈
                  {selection.attribution.rightsAttribution.workTitle.text}〉
                </span>
                <span aria-hidden="true"> · </span>
              </>
            ) : (
              selection.attribution.license.token.endsWith("-2.0") && (
                <>
                  <span>作品標題：目前來源未提供</span>
                  <span aria-hidden="true"> · </span>
                </>
              )
            )}
            <span>攝影：{selection.attribution.photographer}</span>
            <span aria-hidden="true"> · </span>
            <a
              href={selection.attribution.license.url}
              rel="noopener noreferrer"
            >
              原作 {selection.attribution.license.name}
            </a>
            <span aria-hidden="true"> · </span>
            <a
              href={
                selection.attribution.rightsAttribution.sourceRevision.permalink
              }
              rel="noopener noreferrer"
            >
              Wikimedia Commons 永久說明頁
            </a>
            <span aria-hidden="true"> · </span>
            <span>{selection.attribution.nonEventCaption}</span>
            <span aria-hidden="true"> · </span>
            <span>本站版面以 CSS 裁切（已作變更）。</span>
          </>
        ) : selection.attribution.rightsAttribution.licenseBucket ===
          "cc-by-sa" ? (
          <>
            {selection.attribution.rightsAttribution.workTitle.status ===
            "supplied" ? (
              <>
                <span>
                  作品：〈
                  {selection.attribution.rightsAttribution.workTitle.text}〉
                </span>
                <span aria-hidden="true"> · </span>
              </>
            ) : (
              selection.attribution.license.token.endsWith("-2.0") && (
                <>
                  <span>作品標題：目前來源未提供</span>
                  <span aria-hidden="true"> · </span>
                </>
              )
            )}
            <span>攝影：{selection.attribution.photographer}</span>
            <span aria-hidden="true"> · </span>
            <a
              href={selection.attribution.license.url}
              rel="noopener noreferrer"
            >
              原作 {selection.attribution.license.name}
            </a>
            <span aria-hidden="true"> · </span>
            <a
              href={
                selection.attribution.rightsAttribution.sourceRevision.permalink
              }
              rel="noopener noreferrer"
            >
              Wikimedia Commons 永久說明頁
            </a>
            <span aria-hidden="true"> · </span>
            <span>{selection.attribution.nonEventCaption}</span>
            <span aria-hidden="true"> · </span>
            <span>本站版面以 CSS 裁切（改作）。</span>
            <span aria-hidden="true"> · </span>
            <a
              href={selection.attribution.rightsAttribution.adapterLicense!.url}
              rel="noopener noreferrer"
            >
              本站裁切改作貢獻之 Adapter&apos;s License：
              {selection.attribution.rightsAttribution.adapterLicense!.name}
            </a>
            <span>（不及於頁面其他內容）</span>
          </>
        ) : (
          <>
            {selection.attribution.rightsAttribution.workTitle.status ===
              "supplied" && (
              <>
                <span>
                  作品：〈
                  {selection.attribution.rightsAttribution.workTitle.text}〉
                </span>
                <span aria-hidden="true"> · </span>
              </>
            )}
            <span>創作者：{selection.attribution.photographer}</span>
            <span aria-hidden="true"> · </span>
            <a
              href={selection.attribution.license.url}
              rel="noopener noreferrer"
            >
              {selection.attribution.license.name}
            </a>
            <span aria-hidden="true"> · </span>
            <a
              href={
                selection.attribution.rightsAttribution.sourceRevision.permalink
              }
              rel="noopener noreferrer"
            >
              Wikimedia Commons 永久說明頁
            </a>
            <span aria-hidden="true"> · </span>
            <span>{selection.attribution.nonEventCaption}</span>
            <span aria-hidden="true"> · </span>
            <span>本站版面以 CSS 裁切；不宣告 Adapter&apos;s License。</span>
          </>
        )}
        <span data-attribution-notices>
          {selection.attribution.rightsAttribution.copyrightNotice.status ===
            "supplied" && (
            <>
              <span aria-hidden="true"> · </span>
              <span>
                著作權聲明：
                {selection.attribution.rightsAttribution.copyrightNotice.text}
              </span>
            </>
          )}
          {selection.attribution.rightsAttribution.disclaimerNotice.status ===
            "supplied" && (
            <>
              <span aria-hidden="true"> · </span>
              <span>
                來源免責通知：
                {selection.attribution.rightsAttribution.disclaimerNotice.text}
              </span>
            </>
          )}
          {selection.attribution.rightsAttribution.otherPerFileNotice.status ===
            "supplied" && (
            <>
              <span aria-hidden="true"> · </span>
              <a
                href={
                  selection.attribution.rightsAttribution.otherPerFileNotice
                    .url!
                }
                rel="noopener noreferrer"
              >
                {
                  selection.attribution.rightsAttribution.otherPerFileNotice
                    .text
                }
              </a>
            </>
          )}
        </span>
        <span aria-hidden="true"> · </span>
        <span
          data-source-risk-classification
          data-source-risk-checked-at={
            selection.attribution.sourceRiskClassification.checkedAt
          }
          data-source-risk-revision-permalink={
            selection.attribution.sourceRiskClassification
              .sourceRevisionPermalink
          }
        >
          <span>來源風險分類：{sourceRiskLabel}</span>
          <span aria-hidden="true"> · </span>
          <span>
            查核日：
            {selection.attribution.sourceRiskClassification.checkedAt}
          </span>
          <span aria-hidden="true"> · </span>
          <span data-source-risk-basis>
            分類依據：{selection.attribution.sourceRiskClassification.basis}
          </span>
          <span aria-hidden="true"> · </span>
          <span data-source-risk-no-clearance>
            此分類不代表著作權、肖像權或公開使用已獲放行。
          </span>
        </span>
      </figcaption>
    ) : (
      showFallbackCaption && (
        <figcaption>原創 AI 生成攝影意象，非球員實際影像。</figcaption>
      )
    )
  }
</figure>

<style>
  .case-cover {
    --cover-aspect-ratio: 5 / 2;
    margin: 0 0 1.5rem;
  }

  .case-cover-hero {
    width: min(100%, 48rem);
    margin: 1.25rem 0 0;
  }

  .case-cover-thumb {
    --cover-aspect-ratio: 16 / 9;
    margin: 0;
  }

  .case-cover-facade {
    margin: 0;
  }

  .case-cover-media {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--cover-aspect-ratio);
    background-color: var(--color-surface-muted);
  }

  .case-cover-hero .case-cover-media {
    border-block-end: 2px solid var(--injury-color);
  }

  .case-cover-media :global(picture),
  .case-cover-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .case-cover-media :global(img) {
    object-fit: cover;
    object-position: var(--cover-focal-x) var(--cover-focal-y);
  }

  [data-cover-illustration] {
    display: none;
  }

  .case-cover figcaption {
    margin-top: 0.45rem;
    color: var(--color-ink-muted);
    font: 400 var(--text-meta) / 1.5 var(--font-meta);
  }

  .case-cover-attribution a {
    color: inherit;
    text-underline-offset: 0.15em;
  }

  .case-cover-attribution a:hover {
    color: var(--color-brand-primary);
  }
</style>
