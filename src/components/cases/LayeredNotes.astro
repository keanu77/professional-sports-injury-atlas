---
/**
 * Dual-layer case notes. Both the general and professional sections are
 * always present in server HTML and remain readable in every state; the
 * labeled native button group only toggles visual emphasis via
 * `aria-pressed` and the container's `data-emphasis`, without hiding either
 * controlled section or moving focus. The default slot renders between the
 * two layers so the mobile reading order stays
 * video → general notes → timeline → professional notes.
 */
import type { CaseGeneral, CaseProfessional } from "../../lib/contracts/case";

interface Props {
  scopeId: string;
  general: CaseGeneral;
  professional: CaseProfessional;
}

const { scopeId, general, professional } = Astro.props;
const generalId = `${scopeId}-general-notes`;
const professionalId = `${scopeId}-professional-notes`;
---

<section
  class="layered-notes"
  data-layered-notes
  data-emphasis="general"
  aria-label="雙層案例筆記"
>
  <div class="layer-switch" role="group" aria-label="筆記層級強調切換">
    <button
      type="button"
      class="layer-button"
      data-layer-button="general"
      aria-pressed="true"
      aria-controls={generalId}
    >
      一般讀者筆記
    </button>
    <button
      type="button"
      class="layer-button"
      data-layer-button="professional"
      aria-pressed="false"
      aria-controls={professionalId}
    >
      專業筆記
    </button>
  </div>
  <p class="layer-switch-note">
    兩層筆記永遠同時顯示；此切換只調整視覺強調，不會隱藏任何內容。
  </p>

  <section id={generalId} class="notes-layer" data-layer="general">
    <h3>一般讀者筆記</h3>
    <h4>發生了什麼</h4>
    <p>{general.whatHappened}</p>
    <h4>畫面看得到什麼</h4>
    <p>{general.whatIsVisible}</p>
    <h4>畫面不能證明什麼</h4>
    <p>{general.whatVideoCannotProve}</p>
    <h4>已確認的後續更新</h4>
    <p>{general.confirmedUpdate}</p>
  </section>

  <slot />

  <section id={professionalId} class="notes-layer" data-layer="professional">
    <h3>專業筆記</h3>
    <h4>機轉分析（觀察性）</h4>
    <p>{professional.mechanismAnalysis}</p>
    <h4>臨床限制</h4>
    <p>{professional.clinicalLimitations}</p>
    <h4>鑑別脈絡</h4>
    <p>{professional.differentialContext}</p>
    <h4>治療與回場意涵</h4>
    <p>{professional.treatmentAndRtpMeaning}</p>
  </section>
</section>

<script>
  import { initLayeredNotes } from "../../scripts/layered-notes";

  initLayeredNotes();
</script>

<style>
  .layered-notes {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .layer-switch {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .layer-button {
    min-height: 44px;
    min-width: 44px;
    padding: 0.5rem 1rem;
    border: 2px solid var(--color-brand-primary);
    border-radius: 8px;
    background: var(--color-surface-raised);
    color: var(--color-ink);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .layer-button[aria-pressed="true"] {
    border-color: var(--color-brand-primary);
    background: var(--color-brand-primary);
    color: var(--color-on-brand);
  }

  .layer-switch-note {
    margin: 0;
    font-size: 0.9375rem;
  }

  .notes-layer {
    padding: 1rem;
    border: 2px solid var(--color-brand-primary);
    border-radius: 8px;
    background: var(--color-surface-raised);
  }

  /* Emphasis only: the highlighted layer gains an accent border; text
     contrast in both layers is never reduced. */
  .layered-notes[data-emphasis="general"] .notes-layer[data-layer="general"],
  .layered-notes[data-emphasis="professional"]
    .notes-layer[data-layer="professional"] {
    border-color: var(--color-brand-accent-hover);
  }

  .notes-layer h3 {
    margin-top: 0;
    font-family: var(--font-heading);
  }

  .notes-layer h4 {
    margin-bottom: 0.25rem;
    font-family: var(--font-heading);
  }

  .notes-layer p {
    margin-top: 0;
    white-space: pre-line;
  }
</style>
