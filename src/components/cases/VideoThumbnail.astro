---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props {
  videoId: string;
  priority?: boolean;
}
const { videoId, priority = false } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/videos/*.jpg",
  { eager: true },
);
const image = images[`../../assets/videos/${videoId}.jpg`]?.default;
if (!image) throw new Error(`Missing local YouTube cover: ${videoId}`);
---

<div class="video-thumbnail" data-video-thumbnail={videoId}>
  <Image
    src={image}
    alt=""
    width={480}
    height={360}
    loading={priority ? "eager" : "lazy"}
    fetchpriority={priority ? "high" : undefined}
    decoding="async"
  />
  <slot name="media-action" />
</div>
<style>
  .video-thumbnail {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-surface-muted);
  }
  .video-thumbnail :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0;
    object-fit: cover;
  }
</style>
